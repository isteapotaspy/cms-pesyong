<MudPaper Class="footer-panel" Elevation="0">
    <div class="footer-grid">
        <div>
            <MudText Typo="Typo.h6" Class="footer-brand">Pesyong</MudText>
            <MudText Typo="Typo.body2" Class="footer-copy">
                Delivering authentic Filipino catering and snacks right to your doorstep.
            </MudText>
        </div>

        <div>
            <MudText Typo="Typo.subtitle1">Explore</MudText>
            <div class="footer-links">
                <span>Catering Packages</span>
                <span>Short Orders</span>
                <span>Authentic Kakanin</span>
                <span>Corporate Planning</span>
            </div>
        </div>

        <div>
            <MudText Typo="Typo.subtitle1">Support</MudText>
            <div class="footer-links">
                <span>Track Order</span>
                <span>FAQs</span>
                <span>Contact Us</span>
                <span>Refund Policy</span>
            </div>
        </div>

        <div>
            <MudText Typo="Typo.subtitle1">Newsletter</MudText>
            <div class="newsletter-row">
                <MudTextField T="string"
                              Placeholder="Email address"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary">Join</MudButton>
            </div>
        </div>
    </div>
</MudPaper>