            </div>

            <MudText Typo="Typo.h6" Class="brand-name">Pesyong</MudText>
        </div>

        <div class="topbar-actions">
            @if (ShowHelp)
            {
                <MudIconButton Icon="@Icons.Material.Filled.HelpOutline"
                               Class="topbar-icon-btn help-btn" />
            }

            <MudBadge Content="@DrawerState.CartCount"
                      Color="Color.Primary"
                      Overlap="true"
                      Bordered="true"
                      Invisible="@(DrawerState.CartCount == 0)">
                <MudIconButton Icon="@Icons.Material.Filled.ShoppingCart"
                               Class="topbar-icon-btn cart-icon-btn"
                               OnClick="OpenCart" />
            </MudBadge>

            @if (!Session.IsAuthenticated || Session.Profile is null)
            {
                <MudButton Variant="Variant.Text"
                           Class="nav-action-btn compact-btn"
                           OnClick="@(() => NavManager.NavigateTo("/customer-login"))">
                    Sign in
                </MudButton>
            }
            else
            {
                <div class="account-menu-wrap">
                    <button type="button"
                            class="avatar-trigger"
                            @onclick="ToggleAccountMenu">
                        <MudAvatar Class="nav-avatar">
                            @AvatarLetter
                        </MudAvatar>
                    </button>

                    @if (_showAccountMenu)
                    {
                        <div class="account-dropdown">
                            <button type="button" class="account-dropdown-item" @onclick="GoToProfile">
                                My Profile
                            </button>
                            <button type="button" class="account-dropdown-item" @onclick="GoToOrders">
                                My Orders
                            </button>
                            <button type="button" class="account-dropdown-item danger" @onclick="LogoutAsync">
                                Logout
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="topbar-row topbar-row-search">
        <MudTextField T="string"
                      Value="@SearchText"
                      ValueChanged="@SearchTextChanged"
                      Immediate="true"
                      Placeholder="@SearchPlaceholder"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="search-field" />
    </div>

    <div class="topbar-row topbar-row-meta">
        <MudPaper Class="location-pill" Elevation="0">
            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" />
            <MudText Typo="Typo.body2">@DeliveryLocation</MudText>
        </MudPaper>
    </div>
</MudPaper>

@code {
    [Parameter] public string SearchPlaceholder { get; set; } = "Search for catering, meals, or kakanin...";
    [Parameter] public bool ShowHelp { get; set; } = true;
    [Parameter] public string DeliveryLocation { get; set; } = "Quezon City, Metro Manila";
    [Parameter] public string SearchText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SearchTextChanged { get; set; }

    private bool _showAccountMenu;

    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += HandleSessionChanged;

        if (!Session.IsAuthenticated)
        {
            await AuthService.TryRestoreSessionAsync();
        }
    }

    private void OpenCart()
    {
        DrawerState.OpenCart();
    }

    private void ToggleAccountMenu()
    {
        _showAccountMenu = !_showAccountMenu;
    }

    private void GoToProfile()
    {
        _showAccountMenu = false;
        NavManager.NavigateTo("/customer-profile");
    }

    private void GoToOrders()
    {
        _showAccountMenu = false;
        NavManager.NavigateTo("/customer-orders");
    }

    private async Task LogoutAsync()
    {
        _showAccountMenu = false;
        await AuthService.LogoutAsync();
        NavManager.NavigateTo("/customer-login", true);
    }

    private string AvatarLetter =>
        !string.IsNullOrWhiteSpace(Session.Profile?.FirstName)
            ? Session.Profile.FirstName[0].ToString().ToUpperInvariant()
            : "P";

    private void HandleSessionChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Session.OnChange -= HandleSessionChanged;
    }
}