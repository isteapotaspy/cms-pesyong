@page "/customer-login"
@layout CustomerLayout
@inject ICustomerAuthService AuthService
@inject NavigationManager NavManager

<MudContainer MaxWidth="MaxWidth.False" Class="login-page-shell">
    <div class="login-page-bg"></div>

    <MudContainer MaxWidth="MaxWidth.Large" Class="login-content-wrap">
        <MudGrid Spacing="4" AlignItems="AlignItems.Center" Justify="Justify.Center">
            <MudItem xs="12" md="6">
                <div class="login-welcome-panel">
                    <MudChip T="string"
                             Variant="Variant.Filled"
                             Size="Size.Small"
                             Class="login-chip">
                        Pesyong Fiesta
                    </MudChip>

                    <MudText Typo="Typo.h2" Class="login-title">
                        Welcome back
                    </MudText>

                    <MudText Typo="Typo.h6" Class="login-subtitle">
                        Sign in and continue planning delicious moments with Pesyong.
                    </MudText>
                </div>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Class="login-card" Elevation="0">
                    <div class="login-card-top">
                        <MudText Typo="Typo.h4" Class="login-card-title">
                            Sign in
                        </MudText>

                        <MudText Typo="Typo.body2" Class="login-card-copy">
                            Enter your details to continue to your account.
                        </MudText>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
                            @_errorMessage
                        </MudAlert>
                    }

                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudTextField T="string"
                                          Label="Username or Email"
                                          Variant="Variant.Outlined"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.PersonOutline"
                                          Class="login-input"
                                          @bind-Value="_vm.UserNameOrEmail" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField T="string"
                                          Label="Password"
                                          Variant="Variant.Outlined"
                                          InputType="InputType.Password"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Lock"
                                          Class="login-input"
                                          @bind-Value="_vm.Password" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudButton Variant="Variant.Filled"
                                       FullWidth="true"
                                       Disabled="_isLoading"
                                       Class="login-btn"
                                       OnClick="LoginAsync">
                                @(_isLoading ? "Signing in..." : "Sign in")
                            </MudButton>
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-5" />

                    <div class="login-register-row">
                        <MudText Typo="Typo.body2" Class="login-register-text">
                            No account yet?
                        </MudText>

                        <MudButton Variant="Variant.Text"
                                   Class="login-register-link"
                                   OnClick="@(() => NavManager.NavigateTo("/customer-register"))">
                            Sign up
                        </MudButton>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
</MudContainer>

<style>
    .login-page-shell {
        position: relative;
        min-height: calc(100vh - 64px);
        overflow: hidden;
        padding: 2rem 1rem;
    }

    .login-page-bg {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at top left, rgba(255, 188, 122, 0.26), transparent 32%),
            radial-gradient(circle at bottom right, rgba(255, 134, 61, 0.18), transparent 28%),
            linear-gradient(135deg, #fff8f2 0%, #fff3e7 40%, #fffaf6 100%);
        z-index: 0;
    }

    .login-content-wrap {
        position: relative;
        z-index: 1;
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
    }

    .login-welcome-panel {
        padding: 1rem 1rem 1rem 0.5rem;
    }

    .login-chip {
        background: linear-gradient(90deg, #f18a3b 0%, #de6d1d 100%) !important;
        color: white !important;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .login-title {
        font-weight: 800;
        color: #2f1a0f;
        line-height: 1.05;
        margin-bottom: 0.75rem;
    }

    .login-subtitle {
        color: #74492e;
        font-weight: 400;
        line-height: 1.5;
        max-width: 32rem;
        margin-bottom: 1.5rem;
    }

    .login-card {
        padding: 2rem;
        border-radius: 28px;
        background: rgba(255, 255, 255, 0.94);
        border: 1px solid rgba(240, 162, 104, 0.25);
        box-shadow: 0 20px 50px rgba(118, 63, 24, 0.12);
        backdrop-filter: blur(12px);
    }

    .login-card-top {
        margin-bottom: 1.2rem;
    }

    .login-card-title {
        color: #2e1b10;
        font-weight: 800;
        margin-bottom: 0.35rem;
    }

    .login-card-copy {
        color: #7a5237;
    }

    .login-input .mud-input-control {
        background: rgba(255, 248, 242, 0.75);
        border-radius: 16px;
    }

    .login-btn {
        height: 52px;
        border-radius: 16px !important;
        background: linear-gradient(90deg, #f08a3d 0%, #dd6b1d 100%) !important;
        color: white !important;
        font-weight: 700 !important;
        text-transform: none !important;
        box-shadow: 0 10px 24px rgba(223, 107, 29, 0.28);
    }

    .login-register-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
    }

    .login-register-text {
        color: #7a5237;
    }

    .login-register-link {
        color: #d86b23 !important;
        font-weight: 700 !important;
        text-transform: none !important;
    }
</style>

@code {
    private readonly CustomerLoginVm _vm = new();
    private bool _isLoading;
    private string? _errorMessage;

    private async Task LoginAsync()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;

            await AuthService.LoginAsync(_vm.ToRequest());
            NavManager.NavigateTo("/customer-home", true);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}