@page "/customer-home"
@layout CustomerLayout
@using System.Linq
@using System.Reflection
@using CMS.Contracts.Customer.Promos
@using MauiApp_Pesyong.Shared.Customer_Main.Customer_Models
@using MauiApp_Pesyong.Shared.Customer_Main.Customer_Services
@inject CustomerDrawerState DrawerState
@inject ICustomerCatalogService CatalogService
@inject ISnackbar Snackbar
@implements IDisposable
@inject ICustomerAuthService AuthService
@inject CustomerSession Session
@inject ICustomerOrderService OrderService

<MudContainer MaxWidth="MaxWidth.False" Class="customer-page">
    <TopBar SearchText="@_searchText"
            SearchTextChanged="@((string value) => _searchText = value)"
            DeliveryLocation="@_deliveryLocation" />

    <MudPaper Class="hero-banner" Elevation="0">
        <div class="hero-copy">
            <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Size="Size.Small" Class="hero-chip">
                Seasonal Special
            </MudChip>

            <MudText Typo="Typo.h3" Class="hero-title">
                Celebrate Every Moment with Pesyong Fiesta
            </MudText>

            <MudText Typo="Typo.body1" Class="hero-subtitle">
                From intimate family gatherings to grand corporate events, experience authentic Filipino catering delivered hot and fresh.
            </MudText>

            <div class="hero-actions">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           OnClick="@(() => SetCategory("All Menu"))">
                    Browse Packages
                </MudButton>
            </div>
        </div>
    </MudPaper>

    <div class="category-row">
        <div class="category-left">
            @foreach (var category in _categories)
            {
                <MudButton Variant="Variant.Text"
                           Class="@GetCategoryClass(category)"
                           OnClick="@(() => SetCategory(category))">
                    @category
                </MudButton>
            }
        </div>

        <MudMenu>
            <ActivatorContent>
                <MudButton Variant="Variant.Text"
                           EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                           Class="sort-btn">
                    @CurrentSortLabel
                </MudButton>
            </ActivatorContent>

            <ChildContent>
                @if (!IsShortOrdersView)
                {
                    <MudMenuItem OnClick="@(() => SetSort(SortPopularity))">Popularity</MudMenuItem>
                }

                <MudMenuItem OnClick="@(() => SetSort(SortNameAsc))">Name A-Z</MudMenuItem>
                <MudMenuItem OnClick="@(() => SetSort(SortPriceLowHigh))">Price Low-High</MudMenuItem>
                <MudMenuItem OnClick="@(() => SetSort(SortPriceHighLow))">Price High-Low</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </div>

    <div class="toolbar-row">
        <div class="toolbar-pills">
            <MudPaper Class="toolbar-pill" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" />
                <div>
                    <MudText Typo="Typo.caption">DELIVER TO</MudText>
                    <MudText Typo="Typo.body2">@_homeLocationLabel</MudText>
                </div>
            </MudPaper>

            <MudPaper Class="toolbar-pill" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" />
                <div>
                    <MudText Typo="Typo.caption">DELIVERY TIME</MudText>
                    <MudText Typo="Typo.body2">@_now.ToString("ddd, MMM dd • hh:mm tt")</MudText>
                </div>
            </MudPaper>
        </div>

        <div class="toolbar-actions">
            <MudTextField T="string"
                          Placeholder="@CurrentSearchPlaceholder"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="dish-search"
                          @bind-Value="_searchText" />

            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       Class="filter-btn"
                       OnClick="ResetFilters">
                Reset
            </MudButton>
        </div>
    </div>

    @if (_homeMapLat.HasValue && _homeMapLng.HasValue)
    {
        <MudPaper Class="home-map-card" Elevation="0">
            <MudText Typo="Typo.h6" Class="home-map-title">Delivery Map</MudText>
            <MudText Typo="Typo.body2" Class="home-map-copy">
                Showing your current saved delivery location.
            </MudText>

            <div class="home-map-shell">
                <LocationMap Latitude="_homeMapLat"
                             Longitude="_homeMapLng"
                             Label="Saved Delivery Address"
                             Height="260px" />
            </div>
        </MudPaper>
    }

    @if (_isLoading)
    {
        <MudPaper Class="footer-panel" Elevation="0">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body1" Class="mt-3">Loading menu...</MudText>
        </MudPaper>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudPaper Class="footer-panel" Elevation="0">
            <MudText Typo="Typo.h6" Color="Color.Error">Unable to load menu</MudText>
            <MudText Typo="Typo.body2">@_errorMessage</MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-4"
                       OnClick="LoadDataAsync">
                Retry
            </MudButton>
        </MudPaper>
    }
    else
    {
        @if (_activePromos.Any())
        {
            <section class="section-block">
                <div class="section-head">
                    <div>
                        <MudText Typo="Typo.h4" Class="section-title">Active Promos</MudText>
                        <MudText Typo="Typo.body2" Class="section-subtitle">
                            Use these promo codes during checkout.
                        </MudText>
                    </div>
                </div>

                <div class="package-grid">
                    @foreach (var promo in _activePromos)
                    {
                        <MudPaper Class="checkout-card" Elevation="0">
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">
                                @promo.Code
                            </MudChip>

                            <MudText Typo="Typo.h6" Class="mt-3">@promo.Description</MudText>

                            <MudText Typo="Typo.body2" Class="mt-2">
                                @promo.DiscountPercentageValue% off
                            </MudText>

                            @if (promo.MinimumOrderAmount.HasValue)
                            {
                                <MudText Typo="Typo.caption" Class="mt-1 d-block">
                                    Minimum order: ₱@promo.MinimumOrderAmount.Value.ToString("N0")
                                </MudText>
                            }

                            <MudText Typo="Typo.caption" Class="mt-1 d-block">
                                Valid until @promo.ValidUntilUtc.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")
                            </MudText>
                        </MudPaper>
                    }
                </div>
            </section>
        }

        @if (IsAllMenuView)
        {
            <section class="section-block">
                <div class="section-head">
                    <div>
                        <MudText Typo="Typo.h4" Class="section-title">Packages</MudText>
                        <MudText Typo="Typo.body2" Class="section-subtitle">
                            Showing @AllMenuPackages.Count() delicious package option(s) for your event.
                        </MudText>
                    </div>

                    <MudButton Variant="Variant.Text"
                               EndIcon="@Icons.Material.Filled.KeyboardArrowRight"
                               Class="view-all-btn"
                               OnClick="@(() => SetCategory("Catering"))">
                        View Packages
                    </MudButton>
                </div>

                @if (!AllMenuPackages.Any())
                {
                    <MudPaper Class="footer-panel" Elevation="0">
                        <MudText Typo="Typo.h6">No packages found</MudText>
                        <MudText Typo="Typo.body2">
                            Try another search term.
                        </MudText>
                    </MudPaper>
                }
                else
                {
                    <div class="package-grid">
                        @foreach (var packageItem in AllMenuPackages)
                        {
                            <MudCard Class="food-card">
                                <div class="@GetCardImageClass(packageItem)"
                                     style="@GetCardImageStyle(packageItem)">
                                    @if (!string.IsNullOrWhiteSpace(packageItem.Badge))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Class="card-chip">
                                            @packageItem.Badge
                                        </MudChip>
                                    }
                                </div>

                                <MudCardContent Class="food-card-content">
                                    <MudText Typo="Typo.subtitle1" Class="card-title">@packageItem.Title</MudText>
                                    <MudText Typo="Typo.body2" Class="card-description">@packageItem.CardSummary</MudText>
                                    <MudText Typo="Typo.caption" Class="card-meta">@packageItem.ServesLabel</MudText>
                                </MudCardContent>

                                <MudCardActions Class="food-card-actions">
                                    <div>
                                        <MudText Typo="Typo.h6" Class="card-price">@ToPeso(packageItem.Sizes.FirstOrDefault()?.Price ?? 0)</MudText>
                                        <MudText Typo="Typo.caption" Class="card-price-note">PER PACKAGE</MudText>
                                    </div>

                                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                                   Color="Color.Primary"
                                                   Class="card-add-btn"
                                                   OnClick="@(() => OpenPackage(packageItem))" />
                                </MudCardActions>
                            </MudCard>
                        }
                    </div>
                }
            </section>

            <section class="section-block">
                <div class="section-head">
                    <div>
                        <MudText Typo="Typo.h4" Class="section-title">Short Orders</MudText>
                        <MudText Typo="Typo.body2" Class="section-subtitle">
                            Showing @AllMenuMeals.Count() delicious meal option(s) for quick ordering.
                        </MudText>
                    </div>

                    <MudButton Variant="Variant.Text"
                               EndIcon="@Icons.Material.Filled.KeyboardArrowRight"
                               Class="view-all-btn"
                               OnClick="@(() => SetCategory("Short Orders"))">
                        View Short Orders
                    </MudButton>
                </div>

                @if (!AllMenuMeals.Any())
                {
                    <MudPaper Class="footer-panel" Elevation="0">
                        <MudText Typo="Typo.h6">No meals found</MudText>
                        <MudText Typo="Typo.body2">
                            Try another search term.
                        </MudText>
                    </MudPaper>
                }
                else
                {
                    <div class="package-grid">
                        @foreach (var meal in AllMenuMeals)
                        {
                            <MudCard Class="food-card">
                                <div class="@GetCardImageClass(meal)"
                                     style="@GetCardImageStyle(meal)">
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="Color.Primary"
                                             Variant="Variant.Filled"
                                             Class="card-chip">
                                        @meal.MealType
                                    </MudChip>
                                </div>

                                <MudCardContent Class="food-card-content">
                                    <MudText Typo="Typo.subtitle1" Class="card-title">@meal.Name</MudText>
                                    <MudText Typo="Typo.body2" Class="card-description">@meal.Description</MudText>
                                    <MudText Typo="Typo.caption" Class="card-meta">
                                        Min order: @meal.MinOrderQuantity
                                    </MudText>
                                </MudCardContent>

                                <MudCardActions Class="food-card-actions">
                                    <div>
                                        <MudText Typo="Typo.h6" Class="card-price">@ToPeso(meal.BasePrice)</MudText>
                                        <MudText Typo="Typo.caption" Class="card-price-note">PER ORDER</MudText>
                                    </div>

                                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                                   Color="Color.Primary"
                                                   Class="card-add-btn"
                                                   OnClick="@(() => AddMealToCart(meal))" />
                                </MudCardActions>
                            </MudCard>
                        }
                    </div>
                }
            </section>
        }
        else if (IsShortOrdersView)
        {
            <section class="section-block">
                <div class="section-head">
                    <div>
                        <MudText Typo="Typo.h4" Class="section-title">Short Orders</MudText>
                        <MudText Typo="Typo.body2" Class="section-subtitle">
                            Showing @FilteredMeals.Count() delicious meal option(s) for quick ordering.
                        </MudText>
                    </div>
                </div>

                @if (!FilteredMeals.Any())
                {
                    <MudPaper Class="footer-panel" Elevation="0">
                        <MudText Typo="Typo.h6">No meals found</MudText>
                        <MudText Typo="Typo.body2">
                            Try another search term.
                        </MudText>
                    </MudPaper>
                }
                else
                {
                    <div class="package-grid">
                        @foreach (var meal in FilteredMeals)
                        {
                            <MudCard Class="food-card">
                                <div class="@GetCardImageClass(meal)"
                                     style="@GetCardImageStyle(meal)">
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="Color.Primary"
                                             Variant="Variant.Filled"
                                             Class="card-chip">
                                        @meal.MealType
                                    </MudChip>
                                </div>

                                <MudCardContent Class="food-card-content">
                                    <MudText Typo="Typo.subtitle1" Class="card-title">@meal.Name</MudText>
                                    <MudText Typo="Typo.body2" Class="card-description">@meal.Description</MudText>
                                    <MudText Typo="Typo.caption" Class="card-meta">
                                        Min order: @meal.MinOrderQuantity
                                    </MudText>
                                </MudCardContent>

                                <MudCardActions Class="food-card-actions">
                                    <div>
                                        <MudText Typo="Typo.h6" Class="card-price">@ToPeso(meal.BasePrice)</MudText>
                                        <MudText Typo="Typo.caption" Class="card-price-note">PER ORDER</MudText>
                                    </div>

                                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                                   Color="Color.Primary"
                                                   Class="card-add-btn"
                                                   OnClick="@(() => AddMealToCart(meal))" />
                                </MudCardActions>
                            </MudCard>
                        }
                    </div>
                }
            </section>
        }
        else
        {
            <section class="section-block">
                <div class="section-head">
                    <div>
                        <MudText Typo="Typo.h4" Class="section-title">@CurrentPackageSectionTitle</MudText>
                        <MudText Typo="Typo.body2" Class="section-subtitle">
                            Showing @FilteredPackages.Count() delicious package option(s) for your event.
                        </MudText>
                    </div>
                </div>

                @if (!FilteredPackages.Any())
                {
                    <MudPaper Class="footer-panel" Elevation="0">
                        <MudText Typo="Typo.h6">No packages found</MudText>
                        <MudText Typo="Typo.body2">
                            Try another category or search term.
                        </MudText>
                    </MudPaper>
                }
                else
                {
                    <div class="package-grid">
                        @foreach (var packageItem in FilteredPackages)
                        {
                            <MudCard Class="food-card">
                                <div class="@GetCardImageClass(packageItem)"
                                     style="@GetCardImageStyle(packageItem)">
                                    @if (!string.IsNullOrWhiteSpace(packageItem.Badge))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Class="card-chip">
                                            @packageItem.Badge
                                        </MudChip>
                                    }
                                </div>

                                <MudCardContent Class="food-card-content">
                                    <MudText Typo="Typo.subtitle1" Class="card-title">@packageItem.Title</MudText>
                                    <MudText Typo="Typo.body2" Class="card-description">@packageItem.CardSummary</MudText>
                                    <MudText Typo="Typo.caption" Class="card-meta">@packageItem.ServesLabel</MudText>
                                </MudCardContent>

                                <MudCardActions Class="food-card-actions">
                                    <div>
                                        <MudText Typo="Typo.h6" Class="card-price">@ToPeso(packageItem.Sizes.FirstOrDefault()?.Price ?? 0)</MudText>
                                        <MudText Typo="Typo.caption" Class="card-price-note">PER PACKAGE</MudText>
                                    </div>

                                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                                   Color="Color.Primary"
                                                   Class="card-add-btn"
                                                   OnClick="@(() => OpenPackage(packageItem))" />
                                </MudCardActions>
                            </MudCard>
                        }
                    </div>
                }
            </section>
        }

        <MudPaper Class="promo-panel" Elevation="0">
            <div>
                <MudText Typo="Typo.h4" Class="promo-title">Planning a Large Event?</MudText>
                <MudText Typo="Typo.body1" Class="promo-copy">
                    Our event coordinators are ready to help you customize a menu that perfectly fits your budget and taste.
                </MudText>

                <div class="promo-actions">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="RequestQuote">
                        Get a Free Quote
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Default"
                               Class="hero-secondary-btn"
                               OnClick="ChatWithUs">
                        Chat with Us
                    </MudButton>
                </div>
            </div>

            <div class="promo-image"></div>
        </MudPaper>
    }

    <Footer />
</MudContainer>

@code {
    private const string SortPopularity = "Popularity";
    private const string SortNameAsc = "NameAsc";
    private const string SortPriceLowHigh = "PriceLowHigh";
    private const string SortPriceHighLow = "PriceHighLow";

    private List<string> _categories = new() { "All Menu", "Authentic Kakanin", "Catering", "Short Orders" };
    private List<PackageUiModel> _packages = new();
    private List<ShortOrderMealUiModel> _meals = new();

    private string _selectedCategory = "All Menu";
    private string _searchText = string.Empty;
    private string _sortBy = SortPopularity;
    private bool _isLoading = true;
    private string? _errorMessage;

    private DateTime _now = DateTime.Now;
    private CancellationTokenSource? _clockCts;

    private string _homeLocationLabel = "No saved delivery address";
    private decimal? _homeMapLat;
    private decimal? _homeMapLng;

    private List<ActivePromoDto> _activePromos = new();

    private string _deliveryLocation = "Davao City, Davao del Sur";
    private string _newsletterEmail = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        StartClock();
        await LoadHomeLocationAsync();
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;

            var categories = await CatalogService.GetCategoriesAsync();
            var packages = await CatalogService.GetPackagesAsync();
            var meals = await CatalogService.GetMealsAsync(categorySlug: "short-orders");
            var promos = await OrderService.GetActivePromosAsync();

            _packages = packages.ToList();
            _meals = meals.ToList();
            _activePromos = promos.ToList();

            var fetchedPackageCategories = categories
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct()
                .ToList();

            var finalCategories = new List<string> { "All Menu" };

            if (fetchedPackageCategories.Any(x => x.Equals("Authentic Kakanin", StringComparison.OrdinalIgnoreCase)))
                finalCategories.Add("Authentic Kakanin");

            if (fetchedPackageCategories.Any(x => x.Equals("Catering", StringComparison.OrdinalIgnoreCase)))
                finalCategories.Add("Catering");

            if (!finalCategories.Contains("Short Orders"))
                finalCategories.Add("Short Orders");

            foreach (var extra in fetchedPackageCategories
                .Where(x => !finalCategories.Contains(x))
                .OrderBy(x => x))
            {
                finalCategories.Add(extra);
            }

            _categories = finalCategories;

            if (!_categories.Contains(_selectedCategory))
            {
                _selectedCategory = "All Menu";
            }

            EnsureValidSortForCurrentView();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool IsAllMenuView =>
        _selectedCategory.Equals("All Menu", StringComparison.OrdinalIgnoreCase);

    private bool IsShortOrdersView =>
        _selectedCategory.Equals("Short Orders", StringComparison.OrdinalIgnoreCase);

    private IEnumerable<PackageUiModel> AllMenuPackages =>
        ApplyPackageSort(_packages.Where(x =>
            string.IsNullOrWhiteSpace(_searchText) ||
            x.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            x.CardSummary.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            x.Description.Contains(_searchText, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<ShortOrderMealUiModel> AllMenuMeals =>
        ApplyMealSort(_meals.Where(x =>
            string.IsNullOrWhiteSpace(_searchText) ||
            x.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            x.Description.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            x.MealType.Contains(_searchText, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<PackageUiModel> FilteredPackages =>
        ApplyPackageSort(_packages.Where(x =>
            !IsShortOrdersView &&
            x.MenuCategory.Equals(_selectedCategory, StringComparison.OrdinalIgnoreCase) &&
            (string.IsNullOrWhiteSpace(_searchText) ||
             x.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
             x.CardSummary.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
             x.Description.Contains(_searchText, StringComparison.OrdinalIgnoreCase))));

    private IEnumerable<ShortOrderMealUiModel> FilteredMeals =>
        ApplyMealSort(_meals.Where(x =>
            IsShortOrdersView &&
            (string.IsNullOrWhiteSpace(_searchText) ||
             x.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
             x.Description.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
             x.MealType.Contains(_searchText, StringComparison.OrdinalIgnoreCase))));

    private string CurrentPackageSectionTitle => _selectedCategory;

    private string CurrentSearchPlaceholder =>
        IsAllMenuView ? "Search packages or meals..."
        : IsShortOrdersView ? "Search meals..."
        : "Search packages...";

    private string CurrentSortLabel =>
        _sortBy switch
        {
            SortNameAsc => "Name A-Z",
            SortPriceLowHigh => "Price Low-High",
            SortPriceHighLow => "Price High-Low",
            _ => "Popularity"
        };

    private void SetCategory(string category)
    {
        _selectedCategory = category;
        EnsureValidSortForCurrentView();
    }

    private void SetSort(string sort)
    {
        _sortBy = sort;
        EnsureValidSortForCurrentView();
    }

    private void EnsureValidSortForCurrentView()
    {
        if (IsShortOrdersView && _sortBy == SortPopularity)
        {
            _sortBy = SortNameAsc;
        }
    }

    private IEnumerable<PackageUiModel> ApplyPackageSort(IEnumerable<PackageUiModel> query) =>
        _sortBy switch
        {
            SortNameAsc => query.OrderBy(x => x.Title),
            SortPriceLowHigh => query.OrderBy(x => x.Sizes.FirstOrDefault()?.Price ?? 0m).ThenBy(x => x.Title),
            SortPriceHighLow => query.OrderByDescending(x => x.Sizes.FirstOrDefault()?.Price ?? 0m).ThenBy(x => x.Title),
            _ => query.OrderByDescending(x => x.Rating).ThenByDescending(x => x.ReviewCount).ThenBy(x => x.Title)
        };

    private IEnumerable<ShortOrderMealUiModel> ApplyMealSort(IEnumerable<ShortOrderMealUiModel> query) =>
        _sortBy switch
        {
            SortPriceLowHigh => query.OrderBy(x => x.BasePrice).ThenBy(x => x.Name),
            SortPriceHighLow => query.OrderByDescending(x => x.BasePrice).ThenBy(x => x.Name),
            _ => query.OrderBy(x => x.Name)
        };

    private void ResetFilters()
    {
        _selectedCategory = "All Menu";
        _searchText = string.Empty;
        _sortBy = SortPopularity;
    }

    private void OpenPackage(PackageUiModel packageItem)
    {
        DrawerState.OpenPackage(packageItem);
    }

    private string GetCategoryClass(string category) =>
        category == _selectedCategory ? "category-btn selected" : "category-btn";

    private static string ToPeso(decimal amount) => $"₱{amount:N0}";

    private void AddMealToCart(ShortOrderMealUiModel meal)
    {
        DrawerState.AddToCart(new CartLineUiModel
        {
            Id = $"meal-{meal.Id}",
            MealId = meal.Id,
            IsMealItem = true,
            Name = meal.Name,
            Notes = $"Short Order • Min qty {meal.MinOrderQuantity}",
            UnitPrice = meal.BasePrice,
            Quantity = Math.Max(1, meal.MinOrderQuantity),
            ImageClass = meal.ImageClass,
            ImageUrl = meal.ImageUrl
        });

        Snackbar.Add($"{meal.Name} added to cart.", Severity.Success);
    }

    private void RequestQuote()
    {
        Snackbar.Add("Quote request feature will open soon.", Severity.Info);
    }

    private void ChatWithUs()
    {
        Snackbar.Add("Chat support will be available soon.", Severity.Info);
    }

    private void JoinNewsletter()
    {
        if (string.IsNullOrWhiteSpace(_newsletterEmail))
        {
            Snackbar.Add("Please enter your email address.", Severity.Warning);
            return;
        }

        Snackbar.Add("Thanks for joining our newsletter!", Severity.Success);
        _newsletterEmail = string.Empty;
    }

    private void StartClock()
    {
        _clockCts = new CancellationTokenSource();
        _ = RunClockAsync(_clockCts.Token);
    }

    private async Task RunClockAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                _now = DateTime.Now;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadHomeLocationAsync()
    {
        var restored = await AuthService.TryRestoreSessionAsync();

        if (!restored || !Session.IsAuthenticated)
            return;

        try
        {
            var addresses = await AuthService.GetSavedAddressesAsync();
            var selected = addresses.FirstOrDefault(x => x.IsDefault) ?? addresses.FirstOrDefault();

            if (selected is null)
                return;

            _homeLocationLabel = string.Join(", ",
                new[]
                {
                    selected.StreetAddress,
                    selected.Barangay,
                    selected.City
                }.Where(x => !string.IsNullOrWhiteSpace(x)));

            _homeMapLat = selected.Latitude;
            _homeMapLng = selected.Longitude;

            _deliveryLocation = _homeLocationLabel;
        }
        catch
        {
        }
    }

    private static string GetCardImageClass(object item)
    {
        var imageUrl = TryGetImageUrl(item);
        var imageClass = item.GetType().GetProperty("ImageClass", BindingFlags.Public | BindingFlags.Instance)
            ?.GetValue(item)?.ToString();

        return string.IsNullOrWhiteSpace(imageUrl)
            ? $"food-card-image {imageClass}".Trim()
            : "food-card-image";
    }

    private static string GetCardImageStyle(object item)
    {
        var imageUrl = TryGetImageUrl(item);

        if (string.IsNullOrWhiteSpace(imageUrl))
            return string.Empty;

        return $"background-image: linear-gradient(135deg, rgba(31,24,20,.18), rgba(31,24,20,.04)), url('{imageUrl}'); background-size: cover; background-position: center;";
    }

    private static string? TryGetImageUrl(object item)
    {
        return item.GetType()
            .GetProperty("ImageUrl", BindingFlags.Public | BindingFlags.Instance)
            ?.GetValue(item)
            ?.ToString();
    }

    public void Dispose()
    {
        _clockCts?.Cancel();
        _clockCts?.Dispose();
    }
}