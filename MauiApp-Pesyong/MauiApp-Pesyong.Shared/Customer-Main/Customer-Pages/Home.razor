@page "/customer-home"
@layout CustomerLayout
@using System.Linq
@using MauiApp_Pesyong.Shared.Customer_Main.Customer_Services
@inject CustomerDrawerState DrawerState
@inject ICustomerCatalogService CatalogService

<MudContainer MaxWidth="MaxWidth.False" Class="customer-page">
    <TopBar />

    <MudPaper Class="hero-banner" Elevation="0">
        <div class="hero-copy">
            <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Size="Size.Small" Class="hero-chip">
                Seasonal Special
            </MudChip>

            <MudText Typo="Typo.h3" Class="hero-title">
                Celebrate Every Moment with Pesyong Fiesta
            </MudText>

            <MudText Typo="Typo.body1" Class="hero-subtitle">
                From intimate family gatherings to grand corporate events, experience authentic Filipino catering delivered hot and fresh.
            </MudText>

            <div class="hero-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">
                    Browse Packages
                </MudButton>

                <MudButton Variant="Variant.Filled" Color="Color.Default" Size="Size.Large" Class="hero-secondary-btn">
                    View Kakanin
                </MudButton>
            </div>
        </div>
    </MudPaper>

    <div class="category-row">
        <div class="category-left">
            @foreach (var category in _categories)
            {
                <MudButton Variant="Variant.Text"
                           Class="@GetCategoryClass(category)"
                           OnClick="@(() => _selectedCategory = category)">
                    @category
                </MudButton>
            }
        </div>

        <MudButton Variant="Variant.Text"
                   EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                   Class="sort-btn">
            Popularity
        </MudButton>
    </div>

    <div class="toolbar-row">
        <div class="toolbar-pills">
            <MudPaper Class="toolbar-pill" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" />
                <div>
                    <MudText Typo="Typo.caption">DELIVER TO</MudText>
                    <MudText Typo="Typo.body2">Quezon City, Metro Manila</MudText>
                </div>
            </MudPaper>

            <MudPaper Class="toolbar-pill" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" />
                <div>
                    <MudText Typo="Typo.caption">DELIVERY TIME</MudText>
                    <MudText Typo="Typo.body2">Today, 6:00 PM</MudText>
                </div>
            </MudPaper>
        </div>

        <div class="toolbar-actions">
            <MudTextField T="string"
                          Placeholder="Search dishes..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="dish-search"
                          @bind-Value="_searchText" />

            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Tune"
                       Class="filter-btn">
                Filters
            </MudButton>
        </div>
    </div>

    <section class="section-block">
        <div class="section-head">
            <div>
                <MudText Typo="Typo.h4" Class="section-title">@CurrentSectionTitle</MudText>
                <MudText Typo="Typo.body2" Class="section-subtitle">
                    @CurrentSectionSubtitle
                </MudText>
            </div>

            <MudButton Variant="Variant.Text" EndIcon="@Icons.Material.Filled.KeyboardArrowRight" Class="view-all-btn">
                View All
            </MudButton>
        </div>

        @if (_isLoading)
        {
            <MudPaper Class="footer-panel" Elevation="0">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body1" Class="mt-3">Loading menu...</MudText>
            </MudPaper>
        }
        else if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudPaper Class="footer-panel" Elevation="0">
                <MudText Typo="Typo.h6" Color="Color.Error">Unable to load menu</MudText>
                <MudText Typo="Typo.body2">@_errorMessage</MudText>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Class="mt-4"
                           OnClick="LoadDataAsync">
                    Retry
                </MudButton>
            </MudPaper>
        }
        else if (!FilteredPackages.Any())
        {
            <MudPaper Class="footer-panel" Elevation="0">
                <MudText Typo="Typo.h6">No packages found</MudText>
                <MudText Typo="Typo.body2">
                    Try another category or search term.
                </MudText>
            </MudPaper>
        }
        else
        {
            <div class="package-grid">
                @foreach (var packageItem in FilteredPackages)
                {
                    <MudCard Class="food-card">
                        <div class="@($"food-card-image {packageItem.ImageClass}")">
                            @if (!string.IsNullOrWhiteSpace(packageItem.Badge))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Class="card-chip">
                                    @packageItem.Badge
                                </MudChip>
                            }
                        </div>

                        <MudCardContent Class="food-card-content">
                            <MudText Typo="Typo.subtitle1" Class="card-title">@packageItem.Title</MudText>
                            <MudText Typo="Typo.body2" Class="card-description">@packageItem.CardSummary</MudText>
                            <MudText Typo="Typo.caption" Class="card-meta">@packageItem.ServesLabel</MudText>
                        </MudCardContent>

                        <MudCardActions Class="food-card-actions">
                            <div>
                                <MudText Typo="Typo.h6" Class="card-price">@ToPeso(packageItem.Sizes.FirstOrDefault()?.Price ?? 0)</MudText>
                                <MudText Typo="Typo.caption" Class="card-price-note">PER PACKAGE</MudText>
                            </div>

                            <MudIconButton Icon="@Icons.Material.Filled.Add"
                                           Color="Color.Primary"
                                           Class="card-add-btn"
                                           OnClick="@(() => OpenPackage(packageItem))" />
                        </MudCardActions>
                    </MudCard>
                }
            </div>
        }
    </section>

    <MudPaper Class="promo-panel" Elevation="0">
        <div>
            <MudText Typo="Typo.h4" Class="promo-title">Planning a Large Event?</MudText>
            <MudText Typo="Typo.body1" Class="promo-copy">
                Our event coordinators are ready to help you customize a menu that perfectly fits your budget and taste.
            </MudText>

            <div class="promo-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary">
                    Get a Free Quote
                </MudButton>

                <MudButton Variant="Variant.Filled" Color="Color.Default" Class="hero-secondary-btn">
                    Chat with Us
                </MudButton>
            </div>
        </div>

        <div class="promo-image"></div>
    </MudPaper>

    <Footer />
</MudContainer>

@code {
    private List<string> _categories = new() { "All Menu" };
    private List<PackageUiModel> _packages = new();
    private string _selectedCategory = "All Menu";
    private string _searchText = string.Empty;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;

            var categories = await CatalogService.GetCategoriesAsync();
            var packages = await CatalogService.GetPackagesAsync();

            _categories = new List<string> { "All Menu" };
            _categories.AddRange(categories
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct()
                .OrderBy(x => x));

            _packages = packages.ToList();

            if (!_categories.Contains(_selectedCategory))
            {
                _selectedCategory = "All Menu";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IEnumerable<PackageUiModel> FilteredPackages =>
        _packages.Where(x =>
            (_selectedCategory == "All Menu" || x.MenuCategory == _selectedCategory) &&
            (string.IsNullOrWhiteSpace(_searchText) ||
             x.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
             x.CardSummary.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
             x.Description.Contains(_searchText, StringComparison.OrdinalIgnoreCase)));

    private string CurrentSectionTitle =>
        _selectedCategory == "All Menu" ? "All Menu" : _selectedCategory;

    private string CurrentSectionSubtitle =>
        $"Showing {FilteredPackages.Count()} delicious option(s) for your event.";

    private void OpenPackage(PackageUiModel packageItem)
    {
        DrawerState.OpenPackage(packageItem);
    }

    private string GetCategoryClass(string category) =>
        category == _selectedCategory ? "category-btn selected" : "category-btn";

    private static string ToPeso(decimal amount) => $"₱{amount:N0}";
}