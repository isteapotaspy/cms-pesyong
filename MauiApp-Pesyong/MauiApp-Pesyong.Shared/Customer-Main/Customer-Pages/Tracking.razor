@page "/tracking"
@layout CustomerLayout
@using CMS.Contracts.Customer.Orders
@using MauiApp_Pesyong.Shared.Customer_Main.Customer_Services
@using MauiApp_Pesyong.Shared.Customer_Main.Customer_Vms
@using Microsoft.JSInterop
@inject NavigationManager NavManager
@inject CustomerDrawerState DrawerState
@inject ICustomerOrderService OrderService
@inject ICustomerAuthService AuthService
@inject CustomerSession Session
@inject ICustomerOrderRealtimeService RealtimeService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_isLoading)
{
    <MudContainer MaxWidth="MaxWidth.False" Class="customer-page">
        <TopBar />
        <MudPaper Class="tracking-card" Elevation="0">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body1" Class="mt-3">Loading tracking details...</MudText>
        </MudPaper>
    </MudContainer>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudContainer MaxWidth="MaxWidth.False" Class="customer-page">
        <TopBar />
        <MudPaper Class="tracking-card" Elevation="0">
            <MudText Typo="Typo.h6" Color="Color.Error">Unable to load tracking</MudText>
            <MudText Typo="Typo.body2">@_errorMessage</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="ReloadAsync">
                Retry
            </MudButton>
        </MudPaper>
    </MudContainer>
}
else if (Vm is null)
{
    <MudContainer MaxWidth="MaxWidth.False" Class="customer-page">
        <TopBar />
        <MudPaper Class="tracking-card" Elevation="0">
            <MudText Typo="Typo.h6">No active tracking data yet.</MudText>
            <MudText Typo="Typo.body2">Place an order first to see live delivery updates.</MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-4"
                       OnClick="@(() => NavManager.NavigateTo("/customer-orders"))">
                Go to My Orders
            </MudButton>
        </MudPaper>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.False" Class="customer-page">
        <TopBar />

        <MudPaper Class="tracking-hero tracking-hero-card" Elevation="0">
            <div class="tracking-hero-left">
                <div class="tracking-icon-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" />
                </div>

                <div>
                    <MudText Typo="Typo.overline" Class="tracking-eyebrow">ORDER PLACED #@Vm.OrderNumber</MudText>
                    <MudText Typo="Typo.h3" Class="tracking-title">Your order is on the way!</MudText>
                    <MudText Typo="Typo.body1" Class="tracking-subtitle">
                        Ordered at @Vm.OrderedAt.ToString("MMM dd, yyyy • hh:mm tt")
                    </MudText>
                    <MudText Typo="Typo.body2" Class="tracking-live-now">
                        Live now: @_now.ToString("hh:mm tt")
                    </MudText>
                </div>
            </div>

            <div class="tracking-eta tracking-eta-card">
                <MudText Typo="Typo.caption">ESTIMATED DELIVERY</MudText>
                <MudText Typo="Typo.h2">@Vm.EstimatedDeliveryTime.ToString("hh:mm tt")</MudText>
                <MudText Typo="Typo.body2">@Vm.Status</MudText>
            </div>
        </MudPaper>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="8">
                <MudPaper Class="tracking-card" Elevation="0">
                    <div class="tracking-card-header">
                        <MudText Typo="Typo.h6">Delivery Map</MudText>
                        <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">
                            Destination
                        </MudChip>
                    </div>

                    @if (Vm.DeliveryAddress.Latitude.HasValue && Vm.DeliveryAddress.Longitude.HasValue)
                    {
                        <div class="tracking-map-shell">
                            <LocationMap Latitude="Vm.DeliveryAddress.Latitude"
                                         Longitude="Vm.DeliveryAddress.Longitude"
                                         Label="Delivery Address"
                                         Height="340px" />
                        </div>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            Map will appear once delivery coordinates are available.
                        </MudAlert>
                    }
                </MudPaper>

                <MudPaper Class="tracking-card tracking-map-card" Elevation="0">
                    <MudText Typo="Typo.h6" Class="mb-3">Delivery Address</MudText>

                    <div class="address-box">
                        <MudText Typo="Typo.subtitle2">
                            @Vm.DeliveryAddress.StreetAddress
                            @if (!string.IsNullOrWhiteSpace(Vm.DeliveryAddress.City))
                            {
                                <span>, @Vm.DeliveryAddress.City</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Vm.DeliveryAddress.Barangay))
                            {
                                <span>, @Vm.DeliveryAddress.Barangay</span>
                            }
                        </MudText>

                        @if (!string.IsNullOrWhiteSpace(Vm.DeliveryAddress.Landmark))
                        {
                            <MudText Typo="Typo.body2">
                                @Vm.DeliveryAddress.Landmark
                            </MudText>
                        }
                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Class="tracking-card tracking-invoice-card" " Elevation="0">
                    <MudText Typo="Typo.h6" Class="mb-3">Order Status</MudText>

                    <div class="timeline-list">
                        @foreach (var step in Vm.Steps)
                        {
                            <div class="timeline-item @GetStepClass(step.State)">
                                <span class="timeline-bullet"></span>
                                <div>
                                    <MudText Typo="Typo.subtitle2">@step.Title</MudText>
                                    <MudText Typo="Typo.caption">
                                        @step.Description
                                        @if (step.Timestamp.HasValue)
                                        {
                                            <span> • @step.Timestamp.Value.ToString("hh:mm tt")</span>
                                        }
                                    </MudText>
                                </div>
                            </div>
                        }
                    </div>
                </MudPaper>

                <MudPaper Class="tracking-card" Elevation="0">
                    <MudText Typo="Typo.h6" Class="mb-3">Your Selection</MudText>

                    @foreach (var item in Vm.Items)
                    {
                        <div class="selection-item">
                            <div class="selection-thumb @item.ImageClass"></div>
                            <div>
                                <MudText Typo="Typo.subtitle2">@item.Name</MudText>
                                <MudText Typo="Typo.caption">@item.Subtitle</MudText>
                            </div>
                            <MudText Typo="Typo.subtitle2">@ToPeso(item.Amount)</MudText>
                        </div>
                    }

                    <MudDivider Class="my-3" />

                    <div class="summary-row">
                        <MudText Typo="Typo.subtitle2">Total Amount Paid</MudText>
                        <MudText Typo="Typo.subtitle2">@ToPeso(Vm.AmountPaid)</MudText>
                    </div>

                    <MudText Typo="Typo.body2" Class="tracking-invoice-copy">
                        Download a copy of your invoice as a PDF file.
                    </MudText>

                    <MudButton Variant="Variant.Outlined"
                               FullWidth="true"
                               Class="mt-3"
                               OnClick="DownloadInvoiceAsync">
                        Download Invoice
                    </MudButton>
                </MudPaper>

                <MudPaper Class="tracking-help-card" Elevation="0">
                    <MudText Typo="Typo.subtitle2">Need help?</MudText>
                    <MudText Typo="Typo.body2">
                        Contact our support line for immediate help.
                    </MudText>
                </MudPaper>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Class="tracking-back-btn"
                           OnClick="@(() => NavManager.NavigateTo("/customer-orders"))">
                    Back to My Orders
                </MudButton>
            </MudItem>
        </MudGrid>

        <Footer />
    </MudContainer>
}

@code {
    [SupplyParameterFromQuery]
    public int? OrderId { get; set; }

    private TrackingVm? Vm;
    private bool _isLoading = true;
    private string? _errorMessage;
    private int? _joinedOrderId;

    private DateTime _now = DateTime.Now;
    private CancellationTokenSource? _clockCts;
    private IJSObjectReference? _downloadModule;

    protected override void OnInitialized()
    {
        StartClock();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadTrackingAsync();
    }

    private async Task ReloadAsync()
    {
        await LoadTrackingAsync();
    }

    private async Task LoadTrackingAsync()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;

            var restored = await AuthService.TryRestoreSessionAsync();
            if (!restored || !Session.IsAuthenticated)
            {
                var returnUrl = OrderId.HasValue
                    ? $"/tracking?orderId={OrderId.Value}"
                    : "/tracking";

                NavManager.NavigateTo($"/customer-login?returnUrl={Uri.EscapeDataString(returnUrl)}", true);
                return;
            }

            var targetOrderId = ResolveOrderId();

            if (!targetOrderId.HasValue)
            {
                Vm = null;
                return;
            }

            Vm = await OrderService.GetTrackingAsync(targetOrderId.Value);

            if (Vm is null)
            {
                _errorMessage = "Tracking details were not found for this order.";
                return;
            }

            if (_joinedOrderId != targetOrderId.Value)
            {
                try
                {
                    RealtimeService.OrderStatusUpdated -= HandleOrderStatusUpdated;

                    if (_joinedOrderId.HasValue)
                    {
                        await RealtimeService.LeaveOrderAsync(_joinedOrderId.Value);
                    }

                    RealtimeService.OrderStatusUpdated += HandleOrderStatusUpdated;
                    await RealtimeService.JoinOrderAsync(targetOrderId.Value);

                    _joinedOrderId = targetOrderId.Value;
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Live updates unavailable: {ex.Message}", Severity.Warning);
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async void HandleOrderStatusUpdated(OrderStatusUpdatedEvent evt)
    {
        if (!_joinedOrderId.HasValue || evt.OrderId != _joinedOrderId.Value)
            return;

        Snackbar.Add(
            $"Order #{evt.OrderNumber} is now {evt.Status}.",
            GetSnackbarSeverity(evt.Status));

        await InvokeAsync(async () =>
        {
            if (_joinedOrderId.HasValue)
            {
                Vm = await OrderService.GetTrackingAsync(_joinedOrderId.Value);
                StateHasChanged();
            }
        });
    }

    private void StartClock()
    {
        _clockCts = new CancellationTokenSource();
        _ = RunClockAsync(_clockCts.Token);
    }

    private async Task RunClockAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                _now = DateTime.Now;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task DownloadInvoiceAsync()
    {
        if (Vm is null || !int.TryParse(Vm.OrderId, out var orderId))
        {
            Snackbar.Add("Invoice is not available yet.", Severity.Warning);
            return;
        }

        var file = await OrderService.DownloadInvoiceAsync(orderId);

        if (file is null || file.Content.Length == 0)
        {
            Snackbar.Add("Invoice is not available yet.", Severity.Warning);
            return;
        }

        _downloadModule ??= await JS.InvokeAsync<IJSObjectReference>(
                        "import",
                        "/_content/MauiApp-Pesyong.Shared/js/fileDownload.js");

        await _downloadModule.InvokeVoidAsync(
            "downloadFileFromBase64",
            file.FileName,
            file.ContentType,
            Convert.ToBase64String(file.Content));
    }

    private int? ResolveOrderId()
    {
        if (OrderId.HasValue && OrderId.Value > 0)
            return OrderId.Value;

        if (DrawerState.CurrentOrderId.HasValue && DrawerState.CurrentOrderId.Value > 0)
            return DrawerState.CurrentOrderId.Value;

        return null;
    }

    private static string GetStepClass(TrackingStepState state) =>
        state switch
        {
            TrackingStepState.Done => "done",
            TrackingStepState.Active => "active",
            _ => string.Empty
        };

    private static string ToPeso(decimal amount) => $"₱{amount:N0}";

    private static Severity GetSnackbarSeverity(string? status) =>
        status?.Trim().ToLowerInvariant() switch
        {
            "confirmed" => Severity.Info,
            "preparing" => Severity.Warning,
            "outfordelivery" => Severity.Info,
            "out for delivery" => Severity.Info,
            "delivered" => Severity.Success,
            "cancelled" => Severity.Error,
            _ => Severity.Normal
        };

    public async ValueTask DisposeAsync()
    {
        _clockCts?.Cancel();
        _clockCts?.Dispose();

        RealtimeService.OrderStatusUpdated -= HandleOrderStatusUpdated;

        if (_joinedOrderId.HasValue)
        {
            await RealtimeService.LeaveOrderAsync(_joinedOrderId.Value);
        }

        try
        {
            if (_downloadModule is not null)
            {
                await _downloadModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}