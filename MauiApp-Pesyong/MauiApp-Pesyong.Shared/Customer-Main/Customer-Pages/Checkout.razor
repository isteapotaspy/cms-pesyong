@page "/checkout"
@inject CustomerDrawerState DrawerState
@inject NavigationManager NavManager

<MudContainer MaxWidth="MaxWidth.False" Class="customer-page">
    <TopBar />

    <div class="checkout-header">
        <div>
            <MudText Typo="Typo.h3" Class="checkout-page-title">Checkout</MudText>
            <MudText Typo="Typo.body1" Class="checkout-page-subtitle">
                Please review your details and complete your order.
            </MudText>
        </div>
    </div>

    <MudGrid Spacing="3" Class="checkout-grid">
        <MudItem xs="12" md="8">
            <div class="checkout-left">
                <MudPaper Class="checkout-card" Elevation="0">
                    <div class="checkout-card-header">
                        <MudIcon Icon="@Icons.Material.Filled.PersonOutline" />
                        <MudText Typo="Typo.h6">Contact Information</MudText>
                    </div>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string"
                                          Label="Full Name"
                                          Variant="Variant.Outlined"
                                          @bind-Value="_fullName" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField T="string"
                                          Label="Email Address"
                                          Variant="Variant.Outlined"
                                          @bind-Value="_email" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField T="string"
                                          Label="Mobile Number"
                                          Variant="Variant.Outlined"
                                          @bind-Value="_mobile" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudPaper Class="checkout-card" Elevation="0">
                    <div class="checkout-card-header">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" />
                        <MudText Typo="Typo.h6">Delivery Details</MudText>
                    </div>

                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudTextField T="string"
                                          Label="Street Address / Unit No."
                                          Variant="Variant.Outlined"
                                          @bind-Value="_address" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudSelect T="string"
                                       Label="City"
                                       Variant="Variant.Outlined"
                                       @bind-Value="_city">
                                <MudSelectItem Value="@("Quezon City")">Quezon City</MudSelectItem>
                                <MudSelectItem Value="@("Makati")">Makati</MudSelectItem>
                                <MudSelectItem Value="@("Pasig")">Pasig</MudSelectItem>
                                <MudSelectItem Value="@("Taguig")">Taguig</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField T="string"
                                          Label="Barangay"
                                          Variant="Variant.Outlined"
                                          @bind-Value="_barangay" />
                        </MudItem>

                        <MudItem xs="12">
                            <div class="map-placeholder">
                                <div class="map-badge">Delivery Pin</div>
                                <div class="map-copy">Map preview placeholder</div>
                                <div class="map-subcopy">Drag the map to refine your pin location</div>
                            </div>
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField T="string"
                                          Label="Delivery Notes / Landmark"
                                          Variant="Variant.Outlined"
                                          @bind-Value="_landmark" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudPaper Class="checkout-card" Elevation="0">
                    <div class="checkout-card-header">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" />
                        <MudText Typo="Typo.h6">Delivery Schedule</MudText>
                    </div>

                    <MudAlert Severity="Severity.Info"
                              Variant="Variant.Outlined"
                              Dense="true"
                              Class="schedule-alert">
                        All orders are for <strong>Today</strong>. Please select your preferred 30-minute window.
                    </MudAlert>

                    <div class="time-slot-grid">
                        @foreach (var slot in _timeSlots)
                        {
                            <button type="button"
                                    class="@(slot == _selectedTimeSlot ? "time-slot selected" : "time-slot")"
                                    @onclick="@(() => _selectedTimeSlot = slot)">
                                @slot
                            </button>
                        }
                    </div>
                </MudPaper>

                <MudPaper Class="checkout-card" Elevation="0">
                    <div class="checkout-card-header">
                        <MudIcon Icon="@Icons.Material.Filled.CreditCard" />
                        <MudText Typo="Typo.h6">Payment Method</MudText>
                    </div>

                    <div class="payment-grid">
                        @foreach (var option in _paymentOptions)
                        {
                            <button type="button"
                                    class="@(option == _selectedPayment ? "payment-option selected" : "payment-option")"
                                    @onclick="@(() => _selectedPayment = option)">
                                <span class="payment-icon">●</span>
                                <span>@option</span>
                            </button>
                        }
                    </div>
                </MudPaper>
            </div>
        </MudItem>

        <MudItem xs="12" md="4">
            <div class="checkout-right">
                <MudPaper Class="summary-card sticky-summary" Elevation="0">
                    <div class="summary-card-head">
                        <MudText Typo="Typo.h6">Order Summary</MudText>
                        <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">
                            @DrawerState.CartItems.Count item(s)
                        </MudChip>
                    </div>

                    @if (DrawerState.CartItems.Count == 0)
                    {
                        <div class="summary-empty">
                            <MudText Typo="Typo.body2">Your cart is empty.</MudText>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in DrawerState.CartItems)
                        {
                            <div class="summary-item">
                                <div>
                                    <MudText Typo="Typo.subtitle2">@item.Name</MudText>
                                    <MudText Typo="Typo.caption">Qty @item.Quantity • @item.Notes</MudText>
                                </div>

                                <MudText Typo="Typo.subtitle2">@ToPeso(item.LineTotal)</MudText>
                            </div>
                        }
                    }

                    <MudDivider Class="my-3" />

                    <div class="promo-mini-row">
                        <MudTextField T="string"
                                      Placeholder="Enter code"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      @bind-Value="_promoCode" />

                        <MudButton Variant="Variant.Filled" Color="Color.Default">
                            Apply
                        </MudButton>
                    </div>

                    <div class="summary-row">
                        <MudText Typo="Typo.body2">Subtotal</MudText>
                        <MudText Typo="Typo.body2">@ToPeso(SubTotal)</MudText>
                    </div>

                    <div class="summary-row">
                        <MudText Typo="Typo.body2">Delivery Fee</MudText>
                        <MudText Typo="Typo.body2">@ToPeso(DeliveryFee)</MudText>
                    </div>

                    <div class="summary-row">
                        <MudText Typo="Typo.body2">Est. Tax (12%)</MudText>
                        <MudText Typo="Typo.body2">@ToPeso(TaxAmount)</MudText>
                    </div>

                    <div class="summary-row grand-total-row">
                        <MudText Typo="Typo.h6">Grand Total</MudText>
                        <MudText Typo="Typo.h5">@ToPeso(GrandTotal)</MudText>
                    </div>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               Class="place-order-btn"
                               Disabled="@(DrawerState.CartItems.Count == 0)"
                               OnClick="PlaceOrder">
                        Place Order Now
                    </MudButton>

                    <div class="secure-note">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                        <span>Secure checkout powered by Pesyong Pay</span>
                    </div>
                </MudPaper>

                <MudPaper Class="help-card" Elevation="0">
                    <MudText Typo="Typo.subtitle2">Need help with your order?</MudText>
                    <MudText Typo="Typo.body2">
                        Call us at (02) 8888-9999 for instant assistance.
                    </MudText>
                </MudPaper>
            </div>
        </MudItem>
    </MudGrid>

    <Footer />
</MudContainer>

@code {
    private string _fullName = "Juan Dela Cruz";
    private string _email = "juan.dc@email.com";
    private string _mobile = "0917 123 4567";
    private string _address = "Unit 402, Blue Residences";
    private string _city = "Quezon City";
    private string _barangay = "Loyola Heights";
    private string _landmark = "e.g. Near Ateneo Gate 3, call upon arrival";
    private string _promoCode = string.Empty;

    private readonly List<string> _timeSlots = new()
    {
        "10:00 AM",
        "10:30 AM",
        "11:00 AM",
        "11:30 AM",
        "12:00 PM",
        "12:30 PM",
        "01:00 PM",
        "01:30 PM"
    };

    private string _selectedTimeSlot = "11:30 AM";

    private readonly List<string> _paymentOptions = new()
    {
        "GCash",
        "Credit Card",
        "Cash on Delivery"
    };

    private string _selectedPayment = "GCash";

    private decimal SubTotal => DrawerState.SubTotal;
    private decimal DeliveryFee => 0m;
    private decimal TaxAmount => Math.Round(SubTotal * 0.12m, 2);
    private decimal GrandTotal => SubTotal + DeliveryFee + TaxAmount;

    private void PlaceOrder()
    {
        NavManager.NavigateTo("/tracking");
    }

    private static string ToPeso(decimal amount) => $"₱{amount:N0}";
}