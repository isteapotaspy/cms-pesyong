@page "/checkout"
@layout CustomerLayout
@using MauiApp_Pesyong.Shared.Customer_Main.Customer_Services
@using MauiApp_Pesyong.Shared.Customer_Main.Customer_Vms
@using CMS.Contracts.Customer.Profile
@inject CustomerDrawerState DrawerState
@inject NavigationManager NavManager
@inject ICustomerOrderService OrderService
@inject ICustomerAuthService AuthService
@inject CustomerSession Session
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.False" Class="customer-page">
    <TopBar />

    <div class="checkout-header">
        <div>
            <MudText Typo="Typo.h3" Class="checkout-page-title">Checkout</MudText>
            <MudText Typo="Typo.body1" Class="checkout-page-subtitle">
                Please review your details and complete your order.
            </MudText>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
            @_errorMessage
        </MudAlert>
    }

    <MudGrid Spacing="3" Class="checkout-grid">
        <MudItem xs="12" md="8">
            <div class="checkout-left">
                <MudPaper Class="checkout-card" Elevation="0">
                    <div class="checkout-card-header">
                        <MudIcon Icon="@Icons.Material.Filled.PersonOutline" />
                        <MudText Typo="Typo.h6">Contact Information</MudText>
                    </div>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string"
                                          Label="Full Name"
                                          Variant="Variant.Outlined"
                                          @bind-Value="Vm.ContactInfo.FullName" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField T="string"
                                          Label="Email Address"
                                          Variant="Variant.Outlined"
                                          @bind-Value="Vm.ContactInfo.EmailAddress" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField T="string"
                                          Label="Mobile Number"
                                          Variant="Variant.Outlined"
                                          @bind-Value="Vm.ContactInfo.MobileNumber" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudPaper Class="checkout-card" Elevation="0">
                    <div class="checkout-card-header">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" />
                        <MudText Typo="Typo.h6">Delivery Details</MudText>
                    </div>

                    @if (_loadedSavedAddress)
                    {
                        <MudAlert Severity="Severity.Info"
                                  Variant="Variant.Outlined"
                                  Dense="true"
                                  Class="mb-4">
                            Your default saved delivery address has been loaded into checkout.
                        </MudAlert>
                    }

                    @if (_savedAddresses.Any())
                    {
                        <MudPaper Class="saved-address-picker mb-4" Elevation="0">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Saved Addresses</MudText>

                            <MudSelect T="int?"
                                       Label="Choose a saved address"
                                       Variant="Variant.Outlined"
                                       Value="_selectedSavedAddressId"
                                       ValueChanged="OnSavedAddressSelected">
                                @foreach (var address in _savedAddresses)
                                {
                                    <MudSelectItem T="int?" Value="@address.Id">
                                        @FormatSavedAddress(address)
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudPaper>
                    }

                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudTextField T="string"
                                          Label="Street Address / Unit No."
                                          Variant="Variant.Outlined"
                                          @bind-Value="Vm.DeliveryAddress.StreetAddress" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudSelect T="string"
                                       Label="City"
                                       Variant="Variant.Outlined"
                                       @bind-Value="Vm.DeliveryAddress.City">
                                <MudSelectItem Value="@("Davao City")">Davao City</MudSelectItem>
                                <MudSelectItem Value="@("Quezon City")">Quezon City</MudSelectItem>
                                <MudSelectItem Value="@("Makati")">Makati</MudSelectItem>
                                <MudSelectItem Value="@("Pasig")">Pasig</MudSelectItem>
                                <MudSelectItem Value="@("Taguig")">Taguig</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField T="string"
                                          Label="Barangay"
                                          Variant="Variant.Outlined"
                                          @bind-Value="Vm.DeliveryAddress.Barangay" />
                        </MudItem>

                        <MudItem xs="12">
                            <div class="checkout-map-shell">
                                <LocationPickerMap Latitude="Vm.DeliveryAddress.Latitude"
                                                   Longitude="Vm.DeliveryAddress.Longitude"
                                                   Height="260px"
                                                   OnLocationPicked="OnLocationPicked" />
                            </div>

                            <MudText Typo="Typo.caption" Class="mt-2">
                                Tap the map or drag the marker to set your delivery pin.
                            </MudText>
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField T="string"
                                          Label="Delivery Notes / Landmark"
                                          Variant="Variant.Outlined"
                                          @bind-Value="Vm.DeliveryAddress.Landmark" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudPaper Class="checkout-card" Elevation="0">
                    <div class="checkout-card-header">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" />
                        <MudText Typo="Typo.h6">Delivery Schedule</MudText>
                    </div>

                    <MudAlert Severity="Severity.Info"
                              Variant="Variant.Outlined"
                              Dense="true"
                              Class="schedule-alert">
                        All orders are for <strong>@Vm.DeliverySchedule.DeliveryDate:MMMM dd, yyyy</strong>. Please select your preferred 30-minute window.
                    </MudAlert>

                    <MudDatePicker Label="Delivery Date"
                                   Variant="Variant.Outlined"
                                   Date="Vm.DeliverySchedule.DeliveryDate"
                                   DateChanged="OnDeliveryDateChanged"
                                   MinDate="DateTime.Today"
                                   Editable="false"
                                   Class="mb-4" />

                    <div class="time-slot-grid">
                        @foreach (var slot in Vm.AvailableTimeSlots)
                        {
                            <button type="button"
                                    class="@(slot == Vm.DeliverySchedule.TimeSlot ? "time-slot selected" : "time-slot")"
                                    @onclick="@(() => Vm.DeliverySchedule.TimeSlot = slot)">
                                @slot
                            </button>
                        }
                    </div>
                </MudPaper>

                <MudPaper Class="checkout-card" Elevation="0">
                    <div class="checkout-card-header">
                        <MudIcon Icon="@Icons.Material.Filled.CreditCard" />
                        <MudText Typo="Typo.h6">Payment Method</MudText>
                    </div>

                    <div class="payment-grid">
                        @foreach (var option in Vm.AvailablePaymentMethods)
                        {
                            <button type="button"
                                    class="@(option == Vm.PaymentMethod ? "payment-option selected" : "payment-option")"
                                    @onclick="@(() => Vm.PaymentMethod = option)">
                                <span class="payment-icon">●</span>
                                <span>@option</span>
                            </button>
                        }
                    </div>
                </MudPaper>
            </div>
        </MudItem>

        <MudItem xs="12" md="4">
            <div class="checkout-right">
                <MudPaper Class="summary-card sticky-summary" Elevation="0">
                    <div class="summary-card-head">
                        <MudText Typo="Typo.h6">Order Summary</MudText>
                        <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">
                            @Vm.Items.Count item(s)
                        </MudChip>
                    </div>

                    @if (Vm.Items.Count == 0)
                    {
                        <div class="summary-empty">
                            <MudText Typo="Typo.body2">Your cart is empty.</MudText>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in Vm.Items)
                        {
                            <div class="summary-item">
                                <div>
                                    <MudText Typo="Typo.subtitle2">@item.Name</MudText>
                                    <MudText Typo="Typo.caption">Qty @item.Quantity • @item.Notes</MudText>
                                </div>

                                <MudText Typo="Typo.subtitle2">@ToPeso(item.LineTotal)</MudText>
                            </div>
                        }
                    }

                    <MudDivider Class="my-3" />

                    <div class="promo-mini-row">
                        <MudTextField T="string"
                                      Placeholder="Enter code"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      @bind-Value="Vm.PromoCode" />

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Default"
                                   OnClick="ApplyPromoAsync">
                            Apply
                        </MudButton>
                    </div>

                    <div class="summary-row">
                        <MudText Typo="Typo.body2">Subtotal</MudText>
                        <MudText Typo="Typo.body2">@ToPeso(Vm.SubTotal)</MudText>
                    </div>

                    <div class="summary-row">
                        <MudText Typo="Typo.body2">Delivery Fee</MudText>
                        <MudText Typo="Typo.body2">@ToPeso(Vm.DeliveryFee)</MudText>
                    </div>

                    <div class="summary-row">
                        <MudText Typo="Typo.body2">Est. Tax (12%)</MudText>
                        <MudText Typo="Typo.body2">@ToPeso(Vm.TaxAmount)</MudText>
                    </div>

                    <div class="summary-row grand-total-row">
                        <MudText Typo="Typo.h6">Grand Total</MudText>
                        <MudText Typo="Typo.h5">@ToPeso(Vm.GrandTotal)</MudText>
                    </div>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               Class="place-order-btn"
                               Disabled="@(_isPlacingOrder || Vm.Items.Count == 0)"
                               OnClick="PlaceOrderAsync">
                        @(_isPlacingOrder ? "Placing Order..." : "Place Order Now")
                    </MudButton>

                    <div class="secure-note">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                        <span>Secure checkout powered by Pesyong Pay</span>
                    </div>
                </MudPaper>

                <MudPaper Class="help-card" Elevation="0">
                    <MudText Typo="Typo.subtitle2">Need help with your order?</MudText>
                    <MudText Typo="Typo.body2">
                        Call us at (02) 8888-9999 for instant assistance.
                    </MudText>
                </MudPaper>
            </div>
        </MudItem>
    </MudGrid>

    <Footer />
</MudContainer>

@code {
    private CheckoutVm Vm = new();
    private bool _isPlacingOrder;
    private string? _errorMessage;
    private bool _loadedSavedAddress;
    private List<CustomerAddressDto> _savedAddresses = new();
    private int? _selectedSavedAddressId;

    protected override async Task OnInitializedAsync()
    {
        Vm = CheckoutVm.FromCart(DrawerState.CartItems);

        await TryLoadProfileAsync();
        await TryLoadDefaultSavedAddressAsync();
    }

    private async Task TryLoadDefaultSavedAddressAsync()
    {
        try
        {
            var restored = await AuthService.TryRestoreSessionAsync();

            if (!restored || !Session.IsAuthenticated)
                return;

            var addresses = await AuthService.GetSavedAddressesAsync();
            _savedAddresses = addresses.ToList();

            var selected = _savedAddresses.FirstOrDefault(x => x.IsDefault) ?? _savedAddresses.FirstOrDefault();

            if (selected is null)
                return;

            _selectedSavedAddressId = selected.Id;
            ApplySavedAddress(selected);
            _loadedSavedAddress = true;
        }
        catch
        {
            // Keep checkout usable even if saved addresses fail to load.
        }
    }

    private async Task PlaceOrderAsync()
    {
        try
        {
            _isPlacingOrder = true;
            _errorMessage = null;

            var response = await OrderService.PlaceOrderAsync(Vm);

            DrawerState.SetPlacedOrder(response);
            DrawerState.ClearCartAfterCheckout();

            NavManager.NavigateTo($"/tracking?orderId={response.OrderId}");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isPlacingOrder = false;
        }
    }

    private async Task TryLoadProfileAsync()
    {
        try
        {
            var restored = await AuthService.TryRestoreSessionAsync();

            if (!restored || !Session.IsAuthenticated)
                return;

            var me = Session.Profile ?? await AuthService.GetMeAsync();

            if (me is null)
                return;

            Vm.ContactInfo.FullName = me.FullName ?? string.Empty;
            Vm.ContactInfo.EmailAddress = me.Email ?? string.Empty;
            Vm.ContactInfo.MobileNumber = me.MobileNumber ?? string.Empty;
        }
        catch
        {
            // Keep checkout usable even if profile loading fails.
        }
    }

    private static string ToPeso(decimal amount) => $"₱{amount:N0}";

    private Task OnSavedAddressSelected(int? addressId)
    {
        _selectedSavedAddressId = addressId;

        if (!addressId.HasValue)
            return Task.CompletedTask;

        var selected = _savedAddresses.FirstOrDefault(x => x.Id == addressId.Value);
        if (selected is null)
        {
            Snackbar.Add("Saved address not found.", Severity.Warning);
            return Task.CompletedTask;
        }

        ApplySavedAddress(selected);
        Snackbar.Add("Saved address applied to checkout.", Severity.Success);

        StateHasChanged();
        return Task.CompletedTask;
    }

    private void ApplySavedAddress(CustomerAddressDto selected)
    {
        Vm.DeliveryAddress.StreetAddress = selected.StreetAddress ?? string.Empty;
        Vm.DeliveryAddress.City = selected.City ?? string.Empty;
        Vm.DeliveryAddress.Barangay = selected.Barangay ?? string.Empty;
        Vm.DeliveryAddress.Landmark = selected.Landmark ?? string.Empty;
        Vm.DeliveryAddress.Latitude = selected.Latitude;
        Vm.DeliveryAddress.Longitude = selected.Longitude;

        _loadedSavedAddress = true;
    }

    private static string FormatSavedAddress(CustomerAddressDto address)
    {
        var parts = new[]
        {
        address.StreetAddress,
        address.Barangay,
        address.City
    }
        .Where(x => !string.IsNullOrWhiteSpace(x));

        var text = string.Join(", ", parts);

        return address.IsDefault
            ? $"{text} (Default)"
            : text;
    }

    private Task OnLocationPicked(PickedLocationVm location)
    {
        Vm.DeliveryAddress.Latitude = location.Latitude;
        Vm.DeliveryAddress.Longitude = location.Longitude;

        if (!string.IsNullOrWhiteSpace(location.StreetAddress))
            Vm.DeliveryAddress.StreetAddress = location.StreetAddress;

        if (!string.IsNullOrWhiteSpace(location.Barangay))
            Vm.DeliveryAddress.Barangay = location.Barangay;

        if (!string.IsNullOrWhiteSpace(location.City))
            Vm.DeliveryAddress.City = location.City;

        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnDeliveryDateChanged(DateTime? value)
    {
        Vm.DeliverySchedule.DeliveryDate = value?.Date ?? DateTime.Today;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task ApplyPromoAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(Vm.PromoCode))
            {
                Vm.DiscountAmount = 0m;
                Snackbar.Add("Enter a promo code first.", Severity.Warning);
                return;
            }

            var result = await OrderService.ValidatePromoAsync(
                Vm.PromoCode,
                Vm.SubTotal);

            if (result is null)
            {
                Vm.DiscountAmount = 0m;
                Snackbar.Add("Promo code is invalid or expired.", Severity.Error);
                return;
            }

            Vm.DiscountAmount = result.DiscountAmount;
            Snackbar.Add($"{result.Code} applied successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Vm.DiscountAmount = 0m;
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}