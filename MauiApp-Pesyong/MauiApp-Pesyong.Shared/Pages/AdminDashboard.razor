@page "/admin-dashboard"

<PageTitle>Pesyong Admin Dashboard</PageTitle>

<div class="dashboard">
    <section class="dashboard-hero">
        <div class="dashboard-hero__content">
            <div class="dashboard-hero__eyebrow">
                pesyong catering admin
            </div>

            <h1 class="dashboard-hero__title">professional admin dashboard</h1>

            <p class="dashboard-hero__text">
                overview of your catering operations with a cleaner and more polished layout.
                same functionality, better presentation.
            </p>

            <div class="dashboard-hero__actions">
                <a href="/orders" class="dashboard-btn dashboard-btn--primary">open orders</a>
                <a href="/delivery" class="dashboard-btn dashboard-btn--secondary">manage delivery</a>
            </div>
        </div>

        <div class="dashboard-hero__side">
            <div class="dashboard-hero__panel">
                <div class="dashboard-hero__panel-label">welcome back</div>
                <div class="dashboard-hero__panel-value">admin</div>
                <div class="dashboard-hero__panel-text">
                    same logic, better design. this dashboard is only a visual improvement layer.
                </div>
            </div>
        </div>
    </section>

    <section class="dashboard-stats">
        <div class="stat-card">
            <div class="stat-card__title">active meals</div>
            <div class="stat-card__value">24</div>
            <div class="stat-card__caption">currently available</div>
        </div>

        <div class="stat-card">
            <div class="stat-card__title">packages</div>
            <div class="stat-card__value">8</div>
            <div class="stat-card__caption">ready combinations</div>
        </div>

        <div class="stat-card">
            <div class="stat-card__title">deliveries today</div>
            <div class="stat-card__value">12</div>
            <div class="stat-card__caption">scheduled and active</div>
        </div>

        <div class="stat-card">
            <div class="stat-card__title">orders today</div>
            <div class="stat-card__value">13</div>
            <div class="stat-card__caption">new and processing</div>
        </div>
    </section>

    <section class="dashboard-grid">
        <div class="section-card">
            <div class="section-card__header">
                <div>
                    <h3 class="section-card__title">operations overview</h3>
                    <p class="section-card__subtitle">cleaner and more organized content grouping</p>
                </div>
            </div>

            <div class="info-list">
                <div class="info-list__item">
                    <div class="info-list__title">orders management</div>
                    <div class="info-list__text">track customer details, totals, and statuses in one place.</div>
                </div>

                <div class="info-list__item">
                    <div class="info-list__title">delivery tracking</div>
                    <div class="info-list__text">manage riders, schedule, and confirmation flow more clearly.</div>
                </div>

                <div class="info-list__item">
                    <div class="info-list__title">kiosk meals</div>
                    <div class="info-list__text">organize products and pricing with better structure.</div>
                </div>

                <div class="info-list__item">
                    <div class="info-list__title">packages</div>
                    <div class="info-list__text">build meal inclusions and package combinations cleanly.</div>
                </div>
            </div>
        </div>

        <div class="section-card">
            <div class="section-card__header">
                <div>
                    <h3 class="section-card__title">quick actions</h3>
                    <p class="section-card__subtitle">jump to common admin tasks</p>
                </div>
            </div>

            <div class="quick-links">
                <a href="/kiosk-meals" class="quick-links__item">add new meal</a>
                <a href="/catering-packages" class="quick-links__item">create package</a>
                <a href="/delivery" class="quick-links__item">track delivery</a>
                <a href="/orders" class="quick-links__item">open orders</a>
            </div>
        </div>
    </section>
</div>