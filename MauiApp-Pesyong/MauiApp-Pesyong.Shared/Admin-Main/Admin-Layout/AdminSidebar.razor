@using Microsoft.AspNetCore.Components

<nav class="sidebar">
    <div class="sidebar__brand">
        <div class="sidebar__brand-icon">P</div>
        <div>
            <div class="sidebar__brand-title">Pesyong</div>
            <div class="sidebar__brand-subtitle">Catering Admin</div>
        </div>
    </div>

    <div class="sidebar__search">
        <svg class="sidebar__search-icon" width="14" height="14" viewBox="0 0 16 16" fill="none"><circle cx="6.5" cy="6.5" r="5.5" stroke="currentColor" stroke-width="1.5"/><path d="M11 11l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <input placeholder="Search..." />
    </div>

    <div class="sidebar__nav">
        <NavLink href="/admin-dashboard" class="sidebar__link" ActiveClass="active" Match="NavLinkMatch.All" @onclick="Navigate">
            <svg class="sidebar__link-icon" width="18" height="18" viewBox="0 0 20 20" fill="none"><rect x="2" y="2" width="7" height="7" rx="2" stroke="currentColor" stroke-width="1.5"/><rect x="11" y="2" width="7" height="7" rx="2" stroke="currentColor" stroke-width="1.5"/><rect x="2" y="11" width="7" height="7" rx="2" stroke="currentColor" stroke-width="1.5"/><rect x="11" y="11" width="7" height="7" rx="2" stroke="currentColor" stroke-width="1.5"/></svg>
            <span>Dashboard</span>
        </NavLink>

        <!-- Foodstuff -->
        <button class="sidebar__group-toggle" @onclick="() => ToggleGroup(0)">
            <svg class="sidebar__link-icon" width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M3 6h14M3 10h10M3 14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            <span>Foodstuff</span>
            <svg class="sidebar__chevron @(IsOpen(0) ? "open" : "")" width="12" height="12" viewBox="0 0 12 12"><path d="M4 5l2 2 2-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/></svg>
        </button>
        @if (IsOpen(0))
        {
            <div class="sidebar__group-items">
                <NavLink href="/kiosk-meals" class="sidebar__link sub" ActiveClass="active" @onclick="Navigate">
                    <svg class="sidebar__link-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.3"/><path d="M5 6h6M5 8h4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                    <span>Kiosk Meals</span>
                </NavLink>
                <NavLink href="/catering-packages" class="sidebar__link sub" ActiveClass="active" @onclick="Navigate">
                    <svg class="sidebar__link-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="3" width="12" height="10" rx="2" stroke="currentColor" stroke-width="1.3"/><path d="M2 7h12" stroke="currentColor" stroke-width="1.3"/></svg>
                    <span>Catering Packages</span>
                </NavLink>
            </div>
        }

        <!-- Logistics -->
        <button class="sidebar__group-toggle" @onclick="() => ToggleGroup(1)">
            <svg class="sidebar__link-icon" width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M2 14l4-4 3 3 5-5 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>Logistics</span>
            <svg class="sidebar__chevron @(IsOpen(1) ? "open" : "")" width="12" height="12" viewBox="0 0 12 12"><path d="M4 5l2 2 2-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/></svg>
        </button>
        @if (IsOpen(1))
        {
            <div class="sidebar__group-items">
                <NavLink href="/delivery" class="sidebar__link sub" ActiveClass="active" @onclick="Navigate">
                    <svg class="sidebar__link-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M1 3h9v8H1z" stroke="currentColor" stroke-width="1.3"/><path d="M10 6h3l2 3v4h-5" stroke="currentColor" stroke-width="1.3"/><circle cx="4" cy="12" r="1.5" stroke="currentColor" stroke-width="1.3"/><circle cx="12" cy="12" r="1.5" stroke="currentColor" stroke-width="1.3"/></svg>
                    <span>Delivery</span>
                </NavLink>
            </div>
        }

        <!-- Transactions -->
        <button class="sidebar__group-toggle" @onclick="() => ToggleGroup(2)">
            <svg class="sidebar__link-icon" width="18" height="18" viewBox="0 0 20 20" fill="none"><rect x="3" y="4" width="14" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M3 8h14" stroke="currentColor" stroke-width="1.5"/></svg>
            <span>Transactions</span>
            <svg class="sidebar__chevron @(IsOpen(2) ? "open" : "")" width="12" height="12" viewBox="0 0 12 12"><path d="M4 5l2 2 2-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/></svg>
        </button>
        @if (IsOpen(2))
        {
            <div class="sidebar__group-items">
                <NavLink href="/orders" class="sidebar__link sub" ActiveClass="active" @onclick="Navigate">
                    <svg class="sidebar__link-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 2h8l1 3H3l1-3zM3 5h10v9H3z" stroke="currentColor" stroke-width="1.3"/></svg>
                    <span>Orders</span>
                </NavLink>
                <NavLink href="/payments" class="sidebar__link sub" ActiveClass="active" @onclick="Navigate">
                    <svg class="sidebar__link-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="4" width="14" height="9" rx="2" stroke="currentColor" stroke-width="1.3"/><path d="M1 7h14" stroke="currentColor" stroke-width="1.3"/></svg>
                    <span>Payments</span>
                </NavLink>
                <NavLink href="/acknowledgement-receipts" class="sidebar__link sub" ActiveClass="active" @onclick="Navigate">
                    <svg class="sidebar__link-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 1h8v14l-4-2-4 2V1z" stroke="currentColor" stroke-width="1.3"/></svg>
                    <span>Acknowledgement Receipts</span>
                </NavLink>
            </div>
        }

        <!-- Administration -->
        <button class="sidebar__group-toggle" @onclick="() => ToggleGroup(3)">
            <svg class="sidebar__link-icon" width="18" height="18" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="7" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M4 17c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            <span>Administration</span>
            <svg class="sidebar__chevron @(IsOpen(3) ? "open" : "")" width="12" height="12" viewBox="0 0 12 12"><path d="M4 5l2 2 2-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/></svg>
        </button>
        @if (IsOpen(3))
        {
            <div class="sidebar__group-items">
                <NavLink href="/customers" class="sidebar__link sub" ActiveClass="active" @onclick="Navigate">
                    <svg class="sidebar__link-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="5" r="3" stroke="currentColor" stroke-width="1.3"/><path d="M2 14c0-3 2.7-5 6-5s6 2 6 5" stroke="currentColor" stroke-width="1.3"/></svg>
                    <span>Customers</span>
                </NavLink>
                <NavLink href="/app-users" class="sidebar__link sub" ActiveClass="active" @onclick="Navigate">
                    <svg class="sidebar__link-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="6" cy="5" r="2.5" stroke="currentColor" stroke-width="1.3"/><circle cx="11" cy="6" r="2" stroke="currentColor" stroke-width="1.3"/><path d="M1 13c0-2.5 2-4.5 5-4.5s5 2 5 4.5" stroke="currentColor" stroke-width="1.3"/></svg>
                    <span>App Users</span>
                </NavLink>
                <NavLink href="/system-logs" class="sidebar__link sub" ActiveClass="active" @onclick="Navigate">
                    <svg class="sidebar__link-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 3h10v10H3z" stroke="currentColor" stroke-width="1.3"/><path d="M5 6h6M5 8h4M5 10h5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                    <span>System Logs</span>
                </NavLink>
            </div>
        }
    </div>

    <div class="sidebar__footer">
        <NavLink href="/settings" class="sidebar__link" ActiveClass="active" @onclick="Navigate">
            <svg class="sidebar__link-icon" width="18" height="18" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            <span>Settings</span>
        </NavLink>
    </div>
</nav>

@code {
    [Parameter] public EventCallback OnNavigated { get; set; }

    private HashSet<int> openGroups = new() { 0, 1, 2, 3 };

    private bool IsOpen(int index) => openGroups.Contains(index);

    private void ToggleGroup(int index)
    {
        if (!openGroups.Remove(index))
            openGroups.Add(index);
    }

    private async Task Navigate()
    {
        if (OnNavigated.HasDelegate)
            await OnNavigated.InvokeAsync();
    }
}