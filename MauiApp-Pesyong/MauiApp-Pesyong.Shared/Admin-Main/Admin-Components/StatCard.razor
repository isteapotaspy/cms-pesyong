<div class="stat-card @(Accent ? "accent" : "")">
    <div class="stat-card__header">
        <div class="stat-card__title">@DisplayTitle</div>
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <div class="stat-card__icon">@Icon</div>
        }
    </div>
    <div class="stat-card__value">@Value</div>
    @if (!string.IsNullOrWhiteSpace(Caption))
    {
        <div class="stat-card__caption">@Caption</div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string? Caption { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool Accent { get; set; }

    private string DisplayTitle => !string.IsNullOrWhiteSpace(Label) ? Label : Title;
}