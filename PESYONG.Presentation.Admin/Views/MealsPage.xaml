<Page x:Class="PESYONG.Presentation.Admin.Views.MealsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:converters="clr-namespace:PESYONG.Presentation.Admin.Converters" xmlns:viewmodel="clr-namespace:PESYONG.Presentation.Admin.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:MealPageVM}"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="MealsPage">

    <Page.Resources>
        <converters:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter"/>
    </Page.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Meal list -->
        <ListView Grid.Column="0"
                  MinHeight="100"
                  ItemsSource="{Binding Meals}"
                  SelectedItem="{Binding SelectedMeal, Mode=TwoWay}"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.RowSpan="2"
                                 Width="32"
                                 Height="32"
                                 Margin="6"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Margin="12,6,0,0"
                                   FontWeight="Bold"
                                   Text="{Binding Name, Mode=OneWay}"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="12,0,0,6"
                                   Text="{Binding BasePrice, StringFormat=Price: {0:N2}, Mode=OneWay}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Column="0"
                   Text="No meals found."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="White"
                   Visibility="{Binding Meals.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>

        <!-- RIGHT: Meal details -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Meal Details"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Content="New"
                            Command="{Binding NewMealCommand}"
                            Margin="0,0,8,0"/>

                    <Button Content="{Binding EditSaveButtonText}"
                            Command="{Binding EditOrSaveCommand}"
                            Margin="0,0,8,0"/>

                    <Button Content="Delete"
                            Command="{Binding DeleteCommand}"/>
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="2">

                <!-- GENERAL TAB -->
                <TabItem Header="General">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,8,12,8">

                            <TextBlock Text="{Binding ErrorMessage}"
                                       Margin="0,0,0,8"
                                       TextWrapping="Wrap"
                                       Foreground="Red"/>

                            <!--
                            <TextBlock Text="{Binding StatusMessage}"
                                       Margin="0,0,0,8"
                                       TextWrapping="Wrap"/>
                            -->
                            
                            <!-- Metadata -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="ID:"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedMeal.Id}"/>

                                <TextBlock Grid.Column="2"
                                           Text="Category:"/>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding SelectedMeal.CategoryName}"/>
                            </Grid>

                            <GroupBox Header="Basic Information"
                                      Margin="0,0,0,8">
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="Category ID"
                                               VerticalAlignment="Center"/>

                                    <TextBox Grid.Row="0"
                                             Grid.Column="1"
                                             IsReadOnly="{Binding IsNotEditing}"
                                             Text="{Binding SelectedMeal.CategoryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Text="Category Name"
                                               VerticalAlignment="Center"/>

                                    <TextBox Grid.Row="2"
                                             Grid.Column="1"
                                             IsReadOnly="True"
                                             Text="{Binding SelectedMeal.CategoryName, Mode=OneWay}"/>

                                    <TextBlock Grid.Row="4"
                                               Grid.Column="0"
                                               Text="Meal Type"
                                               VerticalAlignment="Center"/>

                                    <ComboBox Grid.Row="4"
                                              Grid.Column="1"
                                              IsHitTestVisible="{Binding IsEditing}"
                                              Focusable="{Binding IsEditing}"
                                              ItemsSource="{Binding MealTypeOptions}"
                                              SelectedItem="{Binding SelectedMeal.MealType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="6"
                                               Grid.Column="0"
                                               Text="Name"
                                               VerticalAlignment="Center"/>

                                    <TextBox Grid.Row="6"
                                             Grid.Column="1"
                                             IsReadOnly="{Binding IsNotEditing}"
                                             Text="{Binding SelectedMeal.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="8"
                                               Grid.Column="0"
                                               Text="Description"
                                               VerticalAlignment="Top"/>

                                    <TextBox Grid.Row="8"
                                             Grid.Column="1"
                                             MinHeight="72"
                                             IsReadOnly="{Binding IsNotEditing}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             Text="{Binding SelectedMeal.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Pricing and Inventory"
                                      Margin="0,0,0,8">
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="Base Price"
                                               VerticalAlignment="Center"/>

                                    <TextBox Grid.Row="0"
                                             Grid.Column="1"
                                             IsReadOnly="{Binding IsNotEditing}"
                                             Text="{Binding SelectedMeal.BasePrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Text="Stock Quantity"
                                               VerticalAlignment="Center"/>

                                    <TextBox Grid.Row="2"
                                             Grid.Column="1"
                                             IsReadOnly="{Binding IsNotEditing}"
                                             Text="{Binding SelectedMeal.StockQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="4"
                                               Grid.Column="0"
                                               Text="Min Order"
                                               VerticalAlignment="Center"/>

                                    <TextBox Grid.Row="4"
                                             Grid.Column="1"
                                             IsReadOnly="{Binding IsNotEditing}"
                                             Text="{Binding SelectedMeal.MinOrderQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Options">
                                <StackPanel Margin="8">
                                    <CheckBox Content="Available to customers"
                                              IsHitTestVisible="{Binding IsEditing}"
                                              Focusable="{Binding IsEditing}"
                                              IsChecked="{Binding SelectedMeal.IsAvailable, Mode=TwoWay}"
                                              Margin="0,0,0,8"/>

                                    <CheckBox Content="Categorize this meal as a viand option"
                                              IsHitTestVisible="{Binding IsEditing}"
                                              Focusable="{Binding IsEditing}"
                                              IsChecked="{Binding SelectedMeal.IsViandOption, Mode=TwoWay}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- IMAGE TAB -->
                <TabItem Header="Image">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                MinHeight="240"
                BorderThickness="1"
                CornerRadius="4">
                            <Grid Margin="8">
                                <Image Source="{Binding SelectedImagePreviewSource}"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding ImagePlaceholderText}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2"
                    VerticalAlignment="Center">

                            <GroupBox Header="Meal Image">
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Image URL"
                               VerticalAlignment="Center"/>

                                    <TextBox Grid.Row="0"
                                             Grid.Column="1"
                                             Width="112"
                                             IsReadOnly="{Binding IsNotEditing}"
                                             Text="{Binding SelectedMeal.ImageUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>     

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Text="Local File"
                                               VerticalAlignment="Center"/>

                                    <TextBox Grid.Row="2"
                                             Grid.Column="1"
                                             Width="112"
                                             IsReadOnly="True"
                                             Text="{Binding SelectedLocalImagePath, Mode=OneWay}"/>

                                    <StackPanel Grid.Row="4"
                                Grid.Column="1"
                                Orientation="Vertical">
                                        <Button Content="Upload Image"
                                                IsEnabled="{Binding IsEditing}"
                                                Command="{Binding UploadMealImageFromDeviceCommand}"
                                                Margin="0,0,8,0"
                                                HorizontalAlignment="Center"
                                                Width="112"/>

                                        <Button Content="Clear Image" Width="112"
                                                Margin="0,12,0,0"
                                                IsEnabled="{Binding IsEditing}"
                                                Command="{Binding ClearMealImageCommand}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="6"
                               Grid.Column="1"
                               Text="{Binding ImageStatusText}"
                               TextWrapping="Wrap"/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Page>