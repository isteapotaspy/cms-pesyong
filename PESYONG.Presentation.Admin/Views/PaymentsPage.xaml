<Page x:Class="PESYONG.Presentation.Admin.Views.PaymentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PESYONG.Presentation.Admin.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PaymentsPage">

    <Page.Resources>
        <!-- Destructive Button Style -->
        <Style x:Key="DestructiveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,12,12,12"/>
            <Setter Property="Margin" Value="12,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="DarkRed"
                                CornerRadius="4"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF6666"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <Grid Background="{DynamicResource 
        {x:Static SystemColors.ControlDarkDarkColor}}"
        Margin="262,-2,0,2" Width="536">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                               HorizontalAlignment="Left" 
                               Margin="12,12,0,0"
                               Text="Payment Details" 
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"/>

                <StackPanel Grid.Column="1" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right" 
                                Margin="0,12,12,0">

                    <Button Content="New" 
                                        Style="{DynamicResource AccentButtonStyle}"/>
                    <Button Content="Edit" 
                                        Margin="12,0,0,0"/>
                    <Button Content="  Delete  " 
                                        Margin="12,0,24,0"
                                        Style="{StaticResource DestructiveButtonStyle}"/>
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" 
                      Margin="12,0,38,0" 
                      VerticalScrollBarVisibility="Visible"
                      Foreground="White">
                <StackPanel>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Foreground="White">Meal ID:</TextBlock>
                        <TextBlock Grid.Column="1" Foreground="White"></TextBlock>

                        <TextBlock Grid.Column="2" Foreground="White">Timestamp: </TextBlock>
                        <TextBlock Grid.Column="3" Foreground="White"></TextBlock>

                        <TextBlock Grid.Column="4" Foreground="White">Last update:</TextBlock>
                        <TextBlock Grid.Column="5" Foreground="White"></TextBlock>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Commands" />
                            <Button Content="Print Physical Receipt" />
                            <Button Content="Send Email Receipt" />
                            <Button Content="Send SMS Receipt" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <StackPanel>
                                <TextBlock Text="Amount" />
                                <TextBox />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Description" />
                                <TextBox TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Payment Method" Width="120" />
                                    <ComboBox Width="180" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel HorizontalAlignment="Left" Width="240" Margin="12,12,0,12">
            <ListView Height="425" d:ItemsSource="{d:SampleData ItemCount=5}" >
                <ListView.View>
                    <GridView>
                        <GridViewColumn/>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </Grid>
</Page>

