<Page x:Class="PESYONG.Presentation.Admin.Views.PaymentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="PaymentsPage">

    <Page.Resources>
        <Style x:Key="DestructiveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,12,12,12"/>
            <Setter Property="Margin" Value="12,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="DarkRed"
                                CornerRadius="4"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ControlDarkDarkColor}}"
          Margin="12">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListView Grid.Column="0"
          ItemsSource="{Binding Payments}"
          SelectedItem="{Binding SelectedPayment, Mode=TwoWay}"
          HorizontalContentAlignment="Stretch" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           HorizontalAlignment="Left"
                           Margin="0,12,0,0"
                           Text="Payment Details"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">

                    <Button Content="New"
                            Command="{Binding NewPaymentCommand}"
                            Style="{DynamicResource AccentButtonStyle}"/>

                    <Button Content="{Binding EditSaveButtonText}"
                            Command="{Binding EditOrSaveCommand}"
                            Margin="12,0,0,0"/>

                    <Button Content="Delete"
                            Command="{Binding DeleteCommand}"
                            Margin="12,0,0,0"
                            Style="{StaticResource DestructiveButtonStyle}"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Foreground="White">

                <StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="OrangeRed"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Payment ID:" Foreground="White"/>
                            <TextBlock Text="{Binding SelectedPayment.Id}" Foreground="White"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Created:" Foreground="White"/>
                            <TextBlock Text="{Binding SelectedPayment.DateCreated, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                       Foreground="White"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Last Update:" Foreground="White"/>
                            <TextBlock Text="{Binding SelectedPayment.DateUpdated, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                       Foreground="White"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Modified:" Foreground="White"/>
                            <TextBlock Text="{Binding IsModified}" Foreground="White"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel IsEnabled="{Binding IsEditing}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Order ID"
                                       Foreground="White"
                                       Margin="0,0,12,8"/>

                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Text="{Binding SelectedPayment.OrderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="External Reference"
                                       Foreground="White"
                                       Margin="0,0,12,8"/>

                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding SelectedPayment.ExternalReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Payment Method"
                                       Foreground="White"
                                       Margin="0,0,12,8"/>

                            <ComboBox Grid.Row="2"
                                      Grid.Column="1"
                                      ItemsSource="{Binding PaymentMethods}"
                                      SelectedItem="{Binding SelectedPayment.PaymentMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="Payment Status"
                                       Foreground="White"
                                       Margin="0,0,12,8"/>

                            <ComboBox Grid.Row="3"
                                      Grid.Column="1"
                                      ItemsSource="{Binding PaymentStatuses}"
                                      SelectedItem="{Binding SelectedPayment.PaymentStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Text="Timestamp UTC"
                                       Foreground="White"
                                       Margin="0,0,12,8"/>

                            <TextBox Grid.Row="4"
                                     Grid.Column="1"
                                     Text="{Binding SelectedPayment.TimestampUtc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="5"
                                       Grid.Column="0"
                                       Text="Amount"
                                       Foreground="White"
                                       Margin="0,0,12,8"/>

                            <TextBox Grid.Row="5"
                                     Grid.Column="1"
                                     Text="{Binding SelectedPayment.Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="6"
                                       Grid.Column="0"
                                       Text="Description"
                                       Foreground="White"
                                       Margin="0,0,12,8"/>

                            <TextBox Grid.Row="6"
                                     Grid.Column="1"
                                     Text="{Binding SelectedPayment.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Height="80"
                                     Margin="0,0,0,8"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>