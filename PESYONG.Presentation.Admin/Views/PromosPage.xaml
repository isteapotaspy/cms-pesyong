<Page x:Class="PESYONG.Presentation.Admin.Views.PromosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PESYONG.Presentation.Admin.Views"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="PromosPage">

    <Page.Resources>
        <Style x:Key="DestructiveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,12,12,12"/>
            <Setter Property="Margin" Value="12,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="DarkRed"
                                CornerRadius="4"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF6666"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ControlDarkDarkColor}}"
          Margin="12">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Promos"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,8"/>

            <ListView Height="400"
                      ItemsSource="{Binding Promos}"
                      SelectedItem="{Binding SelectedPromo, Mode=TwoWay}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Code"
                                        Width="90"
                                        DisplayMemberBinding="{Binding Code}"/>
                        <GridViewColumn Header="Discount"
                                        Width="70"
                                        DisplayMemberBinding="{Binding DiscountPercentageValue}"/>
                        <GridViewColumn Header="Used"
                                        Width="50"
                                        DisplayMemberBinding="{Binding UsedCount}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,0"
                           Text="Promo Details"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right">

                    <Button Content="New"
                            Command="{Binding NewPromoCommand}"
                            Style="{DynamicResource AccentButtonStyle}"/>

                    <Button Content="{Binding EditSaveButtonText}"
                            Command="{Binding EditOrSaveCommand}"
                            Margin="12,0,0,0"/>

                    <Button Content="Delete"
                            Command="{Binding DeleteCommand}"
                            Margin="12,0,0,0"
                            Style="{StaticResource DestructiveButtonStyle}"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Visible"
                          Foreground="White">

                <StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="Tomato"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <Grid Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Foreground="White"
                                   Text="Promo ID:"/>

                        <TextBlock Grid.Column="1"
                                   Foreground="White"
                                   Text="{Binding SelectedPromo.Id}"/>

                        <TextBlock Grid.Column="2"
                                   Foreground="White"
                                   Text="Creation date:"/>

                        <TextBlock Grid.Column="3"
                                   Foreground="White"
                                   Text="{Binding SelectedPromo.DateCreatedText}"/>

                        <TextBlock Grid.Column="4"
                                   Foreground="White"
                                   Text="Last update:"/>

                        <TextBlock Grid.Column="5"
                                   Foreground="White"
                                   Text="{Binding SelectedPromo.DateUpdatedText}"/>
                    </Grid>

                    <TextBlock Text="{Binding SelectedPromo.ActiveStatusText}"
                               Foreground="LightGreen"
                               Margin="0,0,0,8"/>

                    <StackPanel IsEnabled="{Binding IsFormEnabled}">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Promo Code"
                                       Foreground="White"/>
                            <TextBox Text="{Binding SelectedPromo.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Promo Description"
                                       Foreground="White"/>
                            <TextBox Text="{Binding SelectedPromo.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Height="70"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Discount %"
                                           Foreground="White"/>
                                <TextBox Text="{Binding SelectedPromo.DiscountPercentageValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Minimum Order"
                                           Foreground="White"/>
                                <TextBox Text="{Binding SelectedPromo.MinimumOrderAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <GroupBox Header="Validity and Usage"
                                  Foreground="White"
                                  Margin="0,0,0,12">

                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0"
                                            Grid.Row="0"
                                            Margin="0,0,0,8">
                                    <TextBlock Text="Valid From"
                                               Foreground="White"/>
                                    <DatePicker SelectedDate="{Binding SelectedPromo.ValidFromUtc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="0"
                                            Grid.Row="1">
                                    <TextBlock Text="Valid Until"
                                               Foreground="White"/>
                                    <DatePicker SelectedDate="{Binding SelectedPromo.ValidUntilUtc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Grid.Row="0"
                                            Margin="0,0,0,8">
                                    <TextBlock Text="Usage Limit"
                                               Foreground="White"/>
                                    <TextBox Text="{Binding SelectedPromo.UsageLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Grid.Row="1">
                                    <TextBlock Text="Usage Count"
                                               Foreground="White"/>
                                    <TextBox Text="{Binding SelectedPromo.UsedCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>