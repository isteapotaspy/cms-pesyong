<Page x:Class="PESYONG.Presentation.Admin.Views.DeliveryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="DeliveryPage">

    <Page.Resources>
        <Style x:Key="DestructiveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="DarkRed"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
    </Page.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
          Margin="12">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left List -->
        <ListView Grid.Column="0"
                  ItemsSource="{Binding Deliveries}"
                  SelectedItem="{Binding SelectedDelivery, Mode=TwoWay}"
                  DisplayMemberPath="DisplayName"
                  Margin="0,0,12,0"/>

        <!-- Right Details -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Delivery Details"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="New"
                            Padding="12,8"
                            Command="{Binding NewDeliveryCommand}"/>

                    <Button Content="{Binding EditSaveButtonText}"
                            Padding="12,8"
                            Margin="12,0,0,0"
                            Command="{Binding EditOrSaveCommand}"/>

                    <Button Content="Delete"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource DestructiveButtonStyle}"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="Tomato"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <StackPanel IsEnabled="{Binding IsEditing}">

                        <!-- Readonly summary -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Foreground="White" Text="Delivery ID:"/>
                            <TextBlock Grid.Column="1"
                                       Foreground="White"
                                       Text="{Binding SelectedDelivery.Id}"/>

                            <TextBlock Grid.Column="2" Foreground="White" Text="Status:"/>
                            <TextBlock Grid.Column="3"
                                       Foreground="White"
                                       Text="{Binding SelectedDelivery.Status}"/>
                        </Grid>

                        <TextBlock Foreground="White" Text="Order ID"/>
                        <TextBox Text="{Binding SelectedDelivery.OrderId, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,8"/>

                        <TextBlock Foreground="White" Text="Rider User ID"/>
                        <TextBox Text="{Binding SelectedDelivery.RiderUserId, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                 Margin="0,4,0,8"/>

                        <TextBlock Foreground="White" Text="Delivery Status"/>
                        <ComboBox ItemsSource="{Binding DeliveryStatusOptions}"
                                  SelectedItem="{Binding SelectedDelivery.Status, Mode=TwoWay}"
                                  Margin="0,4,0,8"/>

                        <TextBlock Foreground="White" Text="Delivery Address"/>
                        <TextBox Text="{Binding SelectedDelivery.DeliveryAddressSnapshot, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 Height="70"
                                 TextWrapping="Wrap"
                                 Margin="0,4,0,8"/>

                        <TextBlock Foreground="White" Text="Shipping Cost"/>
                        <TextBox Text="{Binding SelectedDelivery.ShippingCost, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,8"/>

                        <TextBlock Foreground="White" Text="Tracking Number"/>
                        <TextBox Text="{Binding SelectedDelivery.TrackingNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,8"/>

                        <TextBlock Foreground="White" Text="Current Location"/>
                        <TextBox Text="{Binding SelectedDelivery.CurrentLocation, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,8"/>

                        <TextBlock Foreground="White" Text="Estimated Delivery Date UTC"/>
                        <DatePicker SelectedDate="{Binding SelectedDelivery.EstimatedDeliveryDateUtc, Mode=TwoWay}"
                                    Margin="0,4,0,8"/>

                        <TextBlock Foreground="White" Text="Actual Delivery Date UTC"/>
                        <DatePicker SelectedDate="{Binding SelectedDelivery.ActualDeliveryDateUtc, Mode=TwoWay}"
                                    Margin="0,4,0,8"/>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>