<Page x:Class="PESYONG.Presentation.Admin.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PESYONG.Presentation.Admin.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DashboardPage"
      FontFamily="Segoe UI"
      UseLayoutRounding="True">

    <Page.Resources>
        <!-- Microsoft 365 / Fluent-inspired dark palette -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#252525"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="CardBackgroundAltBrush" Color="#303030"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#3D3D3D"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D6D6D6"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#A7A7A7"/>

        <!-- Office-style accents -->
        <SolidColorBrush x:Key="OfficeBlueBrush" Color="#185ABD"/>
        <SolidColorBrush x:Key="OfficeBlueLightBrush" Color="#60CDFF"/>
        <SolidColorBrush x:Key="OfficeGreenBrush" Color="#107C41"/>
        <SolidColorBrush x:Key="OfficeOrangeBrush" Color="#C43E1C"/>
        <SolidColorBrush x:Key="OfficePurpleBrush" Color="#5B5FC7"/>
        <SolidColorBrush x:Key="OfficeYellowBrush" Color="#F2C811"/>

        <!-- Typography -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="MetricLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <Style x:Key="MetricValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <Style x:Key="MetricCaptionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="SectionSubtitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Shapes -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="InnerCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Dashboard"
                               Style="{StaticResource PageTitleTextStyle}"/>

                    <TextBlock Text="Business overview for orders, revenue, customers, meals, and packages."
                               Style="{StaticResource PageSubtitleTextStyle}"/>
                </StackPanel>

                <!-- Microsoft-style rectangular status block, not pill/oblong -->
                <Border Grid.Column="2"
                        Width="178"
                        Height="46"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource OfficeGreenBrush}"
                                CornerRadius="4,0,0,4"/>

                        <Grid Grid.Column="1"
                              Margin="10,6,10,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Realtime updates"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Bottom">
                                <Border Width="7"
                                        Height="7"
                                        Background="{StaticResource OfficeGreenBrush}"
                                        Margin="0,0,6,1"/>

                                <TextBlock Text="{Binding IsStatsConnected, StringFormat=Connected: {0}}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource AppBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Microsoft 365 card row -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="{StaticResource OfficeBlueBrush}"
                                        CornerRadius="2"/>

                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="TOTAL ORDERS"
                                               Style="{StaticResource MetricLabelTextStyle}"/>

                                    <TextBlock Text="{Binding TotalOrders}"
                                               Style="{StaticResource MetricValueTextStyle}"/>

                                    <TextBlock Text="All recorded orders"
                                               Style="{StaticResource MetricCaptionTextStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="{StaticResource OfficeGreenBrush}"
                                        CornerRadius="2"/>

                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="TOTAL REVENUE"
                                               Style="{StaticResource MetricLabelTextStyle}"/>

                                    <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:₱#,##0.00}}"
                                               Style="{StaticResource MetricValueTextStyle}"
                                               FontSize="21"/>

                                    <TextBlock Text="Excluding cancelled"
                                               Style="{StaticResource MetricCaptionTextStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4"
                                Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="{StaticResource OfficePurpleBrush}"
                                        CornerRadius="2"/>

                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="AVERAGE ORDER"
                                               Style="{StaticResource MetricLabelTextStyle}"/>

                                    <TextBlock Text="{Binding AverageOrderValue, StringFormat={}{0:₱#,##0.00}}"
                                               Style="{StaticResource MetricValueTextStyle}"
                                               FontSize="21"/>

                                    <TextBlock Text="Revenue per order"
                                               Style="{StaticResource MetricCaptionTextStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="6"
                                Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="{StaticResource OfficeOrangeBrush}"
                                        CornerRadius="2"/>

                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="CUSTOMERS"
                                               Style="{StaticResource MetricLabelTextStyle}"/>

                                    <TextBlock Text="{Binding TotalCustomers}"
                                               Style="{StaticResource MetricValueTextStyle}"/>

                                    <TextBlock Text="Registered profiles"
                                               Style="{StaticResource MetricCaptionTextStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Order Status -->
                    <Border Grid.Row="2"
                            Style="{StaticResource SectionBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="4"
                                        Background="{StaticResource OfficeBlueBrush}"
                                        CornerRadius="2"/>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Order status"
                                               Style="{StaticResource SectionTitleTextStyle}"/>

                                    <TextBlock Text="Current order distribution by fulfillment stage"
                                               Style="{StaticResource SectionSubtitleTextStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource InnerCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="{StaticResource OfficeYellowBrush}"
                                                CornerRadius="2"/>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Pending"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                                            <TextBlock Text="{Binding PendingOrders}"
                                                       FontSize="23"
                                                       FontWeight="SemiBold"
                                                       Margin="0,5,0,0"/>

                                            <TextBlock Text="Awaiting confirmation"
                                                       Style="{StaticResource MetricCaptionTextStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource InnerCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="{StaticResource OfficeBlueLightBrush}"
                                                CornerRadius="2"/>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Confirmed"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                                            <TextBlock Text="{Binding ConfirmedOrders}"
                                                       FontSize="23"
                                                       FontWeight="SemiBold"
                                                       Margin="0,5,0,0"/>

                                            <TextBlock Text="Ready for fulfillment"
                                                       Style="{StaticResource MetricCaptionTextStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="4"
                                        Style="{StaticResource InnerCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="{StaticResource OfficeGreenBrush}"
                                                CornerRadius="2"/>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Delivered"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                                            <TextBlock Text="{Binding DeliveredOrders}"
                                                       FontSize="23"
                                                       FontWeight="SemiBold"
                                                       Margin="0,5,0,0"/>

                                            <TextBlock Text="Completed orders"
                                                       Style="{StaticResource MetricCaptionTextStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Catalog Availability -->
                    <Border Grid.Row="4"
                            Style="{StaticResource SectionBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="4"
                                        Background="{StaticResource OfficeGreenBrush}"
                                        CornerRadius="2"/>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Catalog availability"
                                               Style="{StaticResource SectionTitleTextStyle}"/>

                                    <TextBlock Text="Available menu items currently visible for ordering"
                                               Style="{StaticResource SectionSubtitleTextStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource InnerCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="{StaticResource OfficeBlueBrush}"
                                                CornerRadius="2"/>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Available packages"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                                            <TextBlock Text="{Binding TotalPackages}"
                                                       FontSize="23"
                                                       FontWeight="SemiBold"
                                                       Margin="0,5,0,0"/>

                                            <TextBlock Text="Packages enabled for customers"
                                                       Style="{StaticResource MetricCaptionTextStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource InnerCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="{StaticResource OfficeOrangeBrush}"
                                                CornerRadius="2"/>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Available meals"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                                            <TextBlock Text="{Binding TotalMeals}"
                                                       FontSize="23"
                                                       FontWeight="SemiBold"
                                                       Margin="0,5,0,0"/>

                                            <TextBlock Text="Meals enabled for customers"
                                                       Style="{StaticResource MetricCaptionTextStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>