<Page x:Class="PESYONG.Presentation.Admin.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="DashboardPage"
      FontFamily="Segoe UI"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Page.Resources>

        <!-- ========================================================= -->
        <!-- App dark theme tokens                                     -->
        <!-- These are intentionally centralized here.                  -->
        <!-- If your app has global theme colors, move these to App.xaml -->
        <!-- ========================================================= -->

        <SolidColorBrush x:Key="DashboardPageBackgroundBrush" Color="#202020"/>
        <SolidColorBrush x:Key="DashboardSurfaceBrush" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="DashboardSubtleSurfaceBrush" Color="#242424"/>

        <SolidColorBrush x:Key="DashboardTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DashboardSecondaryTextBrush" Color="#DADADA"/>
        <SolidColorBrush x:Key="DashboardMutedTextBrush" Color="#A6A6A6"/>

        <!-- Uses Windows accent when available in .NET 9+ -->
        <SolidColorBrush x:Key="DashboardAccentBrush"
                         Color="{DynamicResource {x:Static SystemColors.AccentColorKey}}"/>


        <!-- ========================================================= -->
        <!-- Typography                                                -->
        <!-- ========================================================= -->

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DashboardTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>

        <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource DashboardTextBrush}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource DashboardMutedTextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource DashboardTextBrush}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <Style x:Key="SectionSubtitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource DashboardMutedTextBrush}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="MetricLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource DashboardMutedTextBrush}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="MetricValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource DashboardTextBrush}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="MetricCaptionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource DashboardMutedTextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>


        <!-- ========================================================= -->
        <!-- Borderless dashboard surfaces                             -->
        <!-- ========================================================= -->

        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DashboardSurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="DashboardSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DashboardSurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="DashboardSubCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DashboardSubtleSurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

    </Page.Resources>


    <Grid>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Dashboard"
                               Style="{StaticResource PageTitleTextStyle}"/>

                    <TextBlock Text="Overview of orders, revenue, customers, meals, and packages."
                               Style="{StaticResource PageSubtitleTextStyle}"/>
                </StackPanel>

                <Border Grid.Column="2"
                        Width="190"
                        MinHeight="52"
                        Style="{StaticResource DashboardCardStyle}"
                        Padding="14"
                        VerticalAlignment="Center">

                    <StackPanel>
                        <TextBlock Text="Realtime updates"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DashboardTextBrush}"
                                   TextWrapping="NoWrap"/>

                        <TextBlock Text="{Binding IsStatsConnected, StringFormat=Connected: {0}}"
                                   FontSize="12"
                                   Foreground="{DynamicResource DashboardMutedTextBrush}"
                                   Margin="0,4,0,0"
                                   TextWrapping="NoWrap"/>
                    </StackPanel>
                </Border>
            </Grid>


            <!-- Content -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- Overview cards -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource DashboardCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Total orders"
                                           Style="{StaticResource MetricLabelTextStyle}"/>

                                <TextBlock Text="{Binding TotalOrders}"
                                           Style="{StaticResource MetricValueTextStyle}"/>

                                <TextBlock Text="All recorded orders"
                                           Style="{StaticResource MetricCaptionTextStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource DashboardCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Total revenue"
                                           Style="{StaticResource MetricLabelTextStyle}"/>

                                <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:₱#,##0.00}}"
                                           Style="{StaticResource MetricValueTextStyle}"
                                           FontSize="22"/>

                                <TextBlock Text="Excluding cancelled"
                                           Style="{StaticResource MetricCaptionTextStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4"
                                Style="{StaticResource DashboardCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Average order"
                                           Style="{StaticResource MetricLabelTextStyle}"/>

                                <TextBlock Text="{Binding AverageOrderValue, StringFormat={}{0:₱#,##0.00}}"
                                           Style="{StaticResource MetricValueTextStyle}"
                                           FontSize="22"/>

                                <TextBlock Text="Revenue per order"
                                           Style="{StaticResource MetricCaptionTextStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6"
                                Style="{StaticResource DashboardCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Customers"
                                           Style="{StaticResource MetricLabelTextStyle}"/>

                                <TextBlock Text="{Binding TotalCustomers}"
                                           Style="{StaticResource MetricValueTextStyle}"/>

                                <TextBlock Text="Registered profiles"
                                           Style="{StaticResource MetricCaptionTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>


                    <!-- Order status -->
                    <Border Grid.Row="2"
                            Style="{StaticResource DashboardSectionStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Order status"
                                           Style="{StaticResource SectionTitleTextStyle}"/>

                                <TextBlock Text="Current order distribution by fulfillment stage"
                                           Style="{StaticResource SectionSubtitleTextStyle}"/>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource DashboardSubCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Pending"
                                                   Style="{StaticResource MetricLabelTextStyle}"/>

                                        <TextBlock Text="{Binding PendingOrders}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DashboardTextBrush}"
                                                   Margin="0,8,0,0"/>

                                        <TextBlock Text="Awaiting confirmation"
                                                   Style="{StaticResource MetricCaptionTextStyle}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource DashboardSubCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Confirmed"
                                                   Style="{StaticResource MetricLabelTextStyle}"/>

                                        <TextBlock Text="{Binding ConfirmedOrders}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DashboardTextBrush}"
                                                   Margin="0,8,0,0"/>

                                        <TextBlock Text="Ready for fulfillment"
                                                   Style="{StaticResource MetricCaptionTextStyle}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4"
                                        Style="{StaticResource DashboardSubCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Delivered"
                                                   Style="{StaticResource MetricLabelTextStyle}"/>

                                        <TextBlock Text="{Binding DeliveredOrders}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DashboardTextBrush}"
                                                   Margin="0,8,0,0"/>

                                        <TextBlock Text="Completed orders"
                                                   Style="{StaticResource MetricCaptionTextStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>


                    <!-- Catalog availability -->
                    <Border Grid.Row="4"
                            Style="{StaticResource DashboardSectionStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Catalog availability"
                                           Style="{StaticResource SectionTitleTextStyle}"/>

                                <TextBlock Text="Available menu items currently visible for ordering"
                                           Style="{StaticResource SectionSubtitleTextStyle}"/>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource DashboardSubCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Available packages"
                                                   Style="{StaticResource MetricLabelTextStyle}"/>

                                        <TextBlock Text="{Binding TotalPackages}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DashboardTextBrush}"
                                                   Margin="0,8,0,0"/>

                                        <TextBlock Text="Packages enabled for customers"
                                                   Style="{StaticResource MetricCaptionTextStyle}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource DashboardSubCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Available meals"
                                                   Style="{StaticResource MetricLabelTextStyle}"/>

                                        <TextBlock Text="{Binding TotalMeals}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DashboardTextBrush}"
                                                   Margin="0,8,0,0"/>

                                        <TextBlock Text="Meals enabled for customers"
                                                   Style="{StaticResource MetricCaptionTextStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>