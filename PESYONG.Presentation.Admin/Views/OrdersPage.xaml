<Page x:Class="PESYONG.Presentation.Admin.Views.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="OrdersPage">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Order list -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Orders"
                       FontSize="20"
                       FontWeight="SemiBold"/>

            <ListView Grid.Row="2"
                      ItemsSource="{Binding Orders}"
                      SelectedItem="{Binding SelectedOrder, Mode=TwoWay}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Order No."
                                        Width="95"
                                        DisplayMemberBinding="{Binding OrderNumber}"/>

                        <GridViewColumn Header="Status"
                                        Width="75"
                                        DisplayMemberBinding="{Binding Status}"/>

                        <GridViewColumn Header="Total"
                                        Width="60"
                                        DisplayMemberBinding="{Binding GrandTotal}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- RIGHT: Order details -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Order Details"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Content="New"
                            Command="{Binding NewOrderCommand}"
                            Margin="0,0,8,0"/>

                    <Button Content="{Binding EditSaveButtonText}"
                            Command="{Binding EditOrSaveCommand}"
                            Margin="0,0,8,0"/>

                    <Button Content="Delete"
                            Command="{Binding DeleteCommand}"/>
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="2">

                <!-- GENERAL TAB -->
                <TabItem Header="General">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="0,8,8,8">
                        <StackPanel>

                            <TextBlock Text="{Binding ErrorMessage}"
                                       Margin="0,0,0,8"/>

                            <!-- Metadata -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="ID:"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedOrder.Id}"/>

                                <TextBlock Grid.Column="2"
                                           Text="Created:"/>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding SelectedOrder.DateCreated, StringFormat={}{0:g}}"/>

                                <TextBlock Grid.Column="4"
                                           Text="Updated:"/>
                                <TextBlock Grid.Column="5"
                                           Text="{Binding SelectedOrder.DateUpdated, StringFormat={}{0:g}}"/>
                            </Grid>

                            <Grid IsEnabled="{Binding IsEditing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>

                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>

                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>

                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>

                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>

                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>

                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>

                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>

                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>

                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>

                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>

                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>

                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>

                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>

                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Order Number"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0"
                                         Grid.Column="1"
                                         Text="{Binding SelectedOrder.OrderNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="Customer ID"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         Text="{Binding SelectedOrder.CustomerProfileId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           Text="Address ID"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="4"
                                         Grid.Column="1"
                                         Text="{Binding SelectedOrder.AddressId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                                <TextBlock Grid.Row="6"
                                           Grid.Column="0"
                                           Text="Ordered At"
                                           VerticalAlignment="Center"/>
                                <DatePicker Grid.Row="6"
                                            Grid.Column="1"
                                            SelectedDate="{Binding SelectedOrder.OrderedAtUtc, Mode=TwoWay}"/>

                                <TextBlock Grid.Row="8"
                                           Grid.Column="0"
                                           Text="Delivery Date"
                                           VerticalAlignment="Center"/>
                                <DatePicker Grid.Row="8"
                                            Grid.Column="1"
                                            SelectedDate="{Binding SelectedOrder.DeliveryDate, Mode=TwoWay}"/>

                                <TextBlock Grid.Row="10"
                                           Grid.Column="0"
                                           Text="Time Slot"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="10"
                                         Grid.Column="1"
                                         Text="{Binding SelectedOrder.DeliveryTimeSlot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="12"
                                           Grid.Column="0"
                                           Text="Order Status"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="12"
                                          Grid.Column="1"
                                          ItemsSource="{Binding OrderStatuses}"
                                          SelectedItem="{Binding SelectedOrder.Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"/>

                                <TextBlock Grid.Row="14"
                                           Grid.Column="0"
                                           Text="Payment Method"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="14"
                                          Grid.Column="1"
                                          ItemsSource="{Binding PaymentMethods}"
                                          SelectedItem="{Binding SelectedOrder.PaymentMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"/>

                                <TextBlock Grid.Row="16"
                                           Grid.Column="0"
                                           Text="Payment Status"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="16"
                                          Grid.Column="1"
                                          ItemsSource="{Binding PaymentStatuses}"
                                          SelectedItem="{Binding SelectedOrder.PaymentStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"/>

                                <TextBlock Grid.Row="18"
                                           Grid.Column="0"
                                           Text="Contact Name"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="18"
                                         Grid.Column="1"
                                         Text="{Binding SelectedOrder.ContactNameSnapshot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="20"
                                           Grid.Column="0"
                                           Text="Contact Email"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="20"
                                         Grid.Column="1"
                                         Text="{Binding SelectedOrder.ContactEmailSnapshot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="22"
                                           Grid.Column="0"
                                           Text="Contact Mobile"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="22"
                                         Grid.Column="1"
                                         Text="{Binding SelectedOrder.ContactMobileSnapshot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="24"
                                           Grid.Column="0"
                                           Text="Customer Notes"
                                           VerticalAlignment="Top"/>
                                <TextBox Grid.Row="24"
                                         Grid.Column="1"
                                         MinHeight="48"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Text="{Binding SelectedOrder.CustomerNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="26"
                                           Grid.Column="0"
                                           Text="Instructions"
                                           VerticalAlignment="Top"/>
                                <TextBox Grid.Row="26"
                                         Grid.Column="1"
                                         MinHeight="48"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Text="{Binding SelectedOrder.SpecialInstructions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="28"
                                           Grid.Column="0"
                                           Text="Promo Code"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="28"
                                         Grid.Column="1"
                                         Text="{Binding SelectedOrder.PromoCodeApplied, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TOTALS TAB -->
                <TabItem Header="Totals">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="0,8,8,8">
                        <Grid IsEnabled="{Binding IsEditing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>

                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>

                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>

                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>

                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Subtotal"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Text="{Binding SelectedOrder.SubTotal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Delivery Fee"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Text="{Binding SelectedOrder.DeliveryFee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Text="Tax"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4"
                                     Grid.Column="1"
                                     Text="{Binding SelectedOrder.TaxAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="6"
                                       Grid.Column="0"
                                       Text="Discount"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="6"
                                     Grid.Column="1"
                                     Text="{Binding SelectedOrder.DiscountAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="8"
                                       Grid.Column="0"
                                       Text="Grand Total"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="8"
                                     Grid.Column="1"
                                     Text="{Binding SelectedOrder.GrandTotal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- ITEMS TAB -->
                <TabItem Header="Items">
                    <Grid Margin="0,8,8,8"
                          IsEnabled="{Binding IsEditing}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <ListView ItemsSource="{Binding SelectedOrder.Items}"
                                  SelectedItem="{Binding SelectedOrderLineItem, Mode=TwoWay}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID"
                                                    Width="40"
                                                    DisplayMemberBinding="{Binding Id}"/>

                                    <GridViewColumn Header="Type"
                                                    Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.OrderItemTypes, RelativeSource={RelativeSource AncestorType=Page}}"
                                                          SelectedItem="{Binding ItemType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEditable="True"
                                                          Width="80"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Package"
                                                    Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding PackageId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                         Width="55"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Size"
                                                    Width="60">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding PackageSizeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                         Width="45"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Meal"
                                                    Width="60">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding MealId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                         Width="45"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Title"
                                                    Width="140">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding PackageTitleSnapshot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="125"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Size Label"
                                                    Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding SizeLabelSnapshot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="75"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Price"
                                                    Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding BaseUnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="55"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Qty"
                                                    Width="55">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="40"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Unit"
                                                    Width="65"
                                                    DisplayMemberBinding="{Binding UnitPrice}"/>

                                    <GridViewColumn Header="Total"
                                                    Width="65"
                                                    DisplayMemberBinding="{Binding LineTotal}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- MEAL SELECTIONS TAB -->
                <TabItem Header="Meal Selections">
                    <Grid Margin="0,8,8,8"
                          IsEnabled="{Binding IsEditing}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Select an item from the Items tab to view or edit its meal selections."/>

                        <ListView Grid.Row="2"
                                  ItemsSource="{Binding SelectedOrderLineItem.MealSelections}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID"
                                                    Width="40"
                                                    DisplayMemberBinding="{Binding Id}"/>

                                    <GridViewColumn Header="Rule ID"
                                                    Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding PackageSelectionRuleId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="55"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Meal ID"
                                                    Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding MealId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="55"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Rule"
                                                    Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding RuleTitleSnapshot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="135"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Meal"
                                                    Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding MealNameSnapshot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="135"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Add Price"
                                                    Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding AdditionalPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="65"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- ADDON SELECTIONS TAB -->
                <TabItem Header="Addon Selections">
                    <Grid Margin="0,8,8,8"
                          IsEnabled="{Binding IsEditing}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Select an item from the Items tab to view or edit its addon selections."/>

                        <ListView Grid.Row="2"
                                  ItemsSource="{Binding SelectedOrderLineItem.AddonSelections}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID"
                                                    Width="40"
                                                    DisplayMemberBinding="{Binding Id}"/>

                                    <GridViewColumn Header="Addon ID"
                                                    Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding PackageAddonId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="65"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Addon"
                                                    Width="180">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding AddonNameSnapshot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="165"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Add Price"
                                                    Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding AdditionalPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="65"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</Page>