<Page x:Class="PESYONG.Presentation.Admin.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="LoginPage">

    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center"
                    Margin="36">
            <TextBlock Text="PESYONG"
           FontSize="34"
           FontWeight="SemiBold"
           Foreground="White" />

            <TextBlock Text="Admin Management System"
           FontSize="16"
           Foreground="White"
           Margin="0,8,0,0" />
        </StackPanel>

        <GroupBox Grid.Column="1"
                  Header="PESYONG Admin Login"
                  Margin="12,36,36,36"
                  VerticalAlignment="Center">

            <Grid Margin="12">
                <!-- LOGIN FORM -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVerificationMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Email or Username"
                               Margin="0,8,0,4"
                               Foreground="White"/>

                    <TextBox Text="{Binding EmailOrUsername, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Stretch"
                             Margin="0,0,0,8" />

                    <TextBlock Text="Password"
                               Margin="0,8,0,4"
                               Foreground="White"/>

                    <PasswordBox x:Name="AdminPasswordBox"
                                 PasswordChar="*"
                                 HorizontalAlignment="Stretch"
                                 Margin="0,0,0,8"
                                 PasswordChanged="AdminPasswordBox_PasswordChanged" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Foreground="IndianRed">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding SuccessMessage}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Foreground="LightGreen">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SuccessMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,18,0,0">

                        <Button Content="Login"
                                Margin="0,0,12,0"
                                Style="{DynamicResource AccentButtonStyle}"
                                Command="{Binding LoginCommand}" />

                        <Button Content="Cancel"
                                Click="CancelButton_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- VERIFICATION FORM -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVerificationMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Verification Required"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,8,0,8" />

                    <TextBlock Text="Enter the verification code sent to your admin email."
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <TextBlock Text="Verification Code"
                               Margin="0,8,0,4" />

                    <TextBox Text="{Binding VerificationCode, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Stretch"
                             Margin="0,0,0,8" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Foreground="IndianRed">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding SuccessMessage}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Foreground="LightGreen">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SuccessMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,18,0,0">

                        <Button Content="Back"
                                Margin="0,0,12,0"
                                Command="{Binding BackToLoginCommand}" />

                        <Button Content="Resend"
                                Margin="0,0,12,0"
                                Command="{Binding ResendCodeCommand}" />

                        <Button Content="Verify"
                                Style="{DynamicResource AccentButtonStyle}"
                                Command="{Binding VerifyCodeCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Page>