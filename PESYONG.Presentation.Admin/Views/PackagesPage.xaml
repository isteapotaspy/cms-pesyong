<Page x:Class="PESYONG.Presentation.Admin.Views.PackagesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="PackagesPage">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Package list -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Packages"
                       FontSize="20"
                       FontWeight="SemiBold"/>

            <ListView Grid.Row="2"
                      ItemsSource="{Binding Packages}"
                      SelectedItem="{Binding SelectedPackage, Mode=TwoWay}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Title"
                                        Width="135"
                                        DisplayMemberBinding="{Binding Title}"/>
                        <GridViewColumn Header="Available"
                                        Width="70"
                                        DisplayMemberBinding="{Binding IsAvailable}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- RIGHT: Package details -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Package Details"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Content="New"
                            Command="{Binding NewPackageCommand}"
                            Margin="0,0,8,0"/>

                    <Button Content="{Binding EditSaveButtonText}"
                            Command="{Binding EditOrSaveCommand}"
                            Margin="0,0,8,0"/>

                    <Button Content="Delete"
                            Command="{Binding DeleteCommand}"/>
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="2">

                <!-- GENERAL TAB -->
                <TabItem Header="General">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="0,8,8,8">
                        <StackPanel>

                            <TextBlock Text="{Binding ErrorMessage}"
                                       Margin="0,0,0,8"/>

                            <!-- Metadata -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="ID:"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedPackage.Id}"/>

                                <TextBlock Grid.Column="2"
                                           Text="Rating:"/>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding SelectedPackage.Rating}"/>
                            </Grid>

                            <Grid IsEnabled="{Binding IsEditing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Category"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="0"
                                          Grid.Column="1"
                                          ItemsSource="{Binding MenuCategories}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedPackage.MenuCategoryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="Title"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         Text="{Binding SelectedPackage.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           Text="Description"
                                           VerticalAlignment="Top"/>
                                <TextBox Grid.Row="4"
                                         Grid.Column="1"
                                         MinHeight="56"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Text="{Binding SelectedPackage.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="6"
                                           Grid.Column="0"
                                           Text="Summary"
                                           VerticalAlignment="Top"/>
                                <TextBox Grid.Row="6"
                                         Grid.Column="1"
                                         MinHeight="48"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Text="{Binding SelectedPackage.CardSummary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="8"
                                           Grid.Column="0"
                                           Text="Serves"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="8"
                                         Grid.Column="1"
                                         Text="{Binding SelectedPackage.ServesLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="10"
                                           Grid.Column="0"
                                           Text="Inclusions"
                                           VerticalAlignment="Top"/>
                                <TextBox Grid.Row="10"
                                         Grid.Column="1"
                                         MinHeight="48"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Text="{Binding SelectedPackage.InclusionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="12"
                                           Grid.Column="0"
                                           Text="Badge"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="12"
                                         Grid.Column="1"
                                         Text="{Binding SelectedPackage.Badge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="14"
                                           Grid.Column="0"
                                           Text="Notice"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="14"
                                         Grid.Column="1"
                                         Text="{Binding SelectedPackage.Notice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="16"
                                           Grid.Column="0"
                                           Text="Image URL"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="16"
                                         Grid.Column="1"
                                         Text="{Binding SelectedPackage.ImageUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="18"
                                           Grid.Column="0"
                                           Text="Review Count"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="18"
                                         Grid.Column="1"
                                         Text="{Binding SelectedPackage.ReviewCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <StackPanel Grid.Row="20"
                                            Grid.Column="1"
                                            Orientation="Horizontal">
                                    <CheckBox Content="Available"
                                              IsChecked="{Binding SelectedPackage.IsAvailable, Mode=TwoWay}"
                                              Margin="0,0,16,0"/>

                                    <CheckBox Content="Customizable"
                                              IsChecked="{Binding SelectedPackage.IsCustomizable, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- SIZES TAB -->
                <TabItem Header="Sizes">
                    <Grid Margin="0,8,0,0"
                          IsEnabled="{Binding IsEditing}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0"
                                Content="Add Size"
                                HorizontalAlignment="Left"
                                Command="{Binding AddSizeCommand}"/>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding SelectedPackage.Sizes}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Label"
                                                    Width="*"
                                                    Binding="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <DataGridTextColumn Header="Subtitle"
                                                    Width="*"
                                                    Binding="{Binding Subtitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <DataGridTextColumn Header="Pax"
                                                    Width="70"
                                                    Binding="{Binding PaxCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <DataGridTextColumn Header="Price"
                                                    Width="90"
                                                    Binding="{Binding Price, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <DataGridTemplateColumn Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove"
                                                    Command="{Binding DataContext.RemoveSizeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ADDONS TAB -->
                <TabItem Header="Addons">
                    <Grid Margin="0,8,0,0"
                          IsEnabled="{Binding IsEditing}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0"
                                Content="Add Addon"
                                HorizontalAlignment="Left"
                                Command="{Binding AddAddonCommand}"/>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding SelectedPackage.Addons}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name"
                                                    Width="*"
                                                    Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <DataGridTextColumn Header="Description"
                                                    Width="*"
                                                    Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <DataGridTextColumn Header="Price"
                                                    Width="90"
                                                    Binding="{Binding Price, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <DataGridCheckBoxColumn Header="Available"
                                                        Width="80"
                                                        Binding="{Binding IsAvailable, Mode=TwoWay}"/>

                                <DataGridTemplateColumn Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove"
                                                    Command="{Binding DataContext.RemoveAddonCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- RULES TAB -->
                <TabItem Header="Rules">
                    <Grid Margin="0,8,0,0"
                          IsEnabled="{Binding IsEditing}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0"
                                Content="Add Rule"
                                HorizontalAlignment="Left"
                                Command="{Binding AddSelectionRuleCommand}"/>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding SelectedPackage.SelectionRules}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  RowDetailsVisibilityMode="VisibleWhenSelected">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Title"
                                                    Width="*"
                                                    Binding="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <DataGridTemplateColumn Header="Type"
                                                        Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.SelectionTypeOptions, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      SelectedItem="{Binding SelectionType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Meal Type"
                                                        Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.MealTypeOptions, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      SelectedItem="{Binding AllowedMealType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Min"
                                                    Width="50"
                                                    Binding="{Binding MinSelections, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <DataGridTextColumn Header="Max"
                                                    Width="50"
                                                    Binding="{Binding MaxSelections, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <DataGridCheckBoxColumn Header="Req."
                                                        Width="55"
                                                        Binding="{Binding IsRequired, Mode=TwoWay}"/>

                                <DataGridTemplateColumn Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove"
                                                    Command="{Binding DataContext.RemoveSelectionRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>

                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0"
                                                Content="Add Option"
                                                HorizontalAlignment="Left"
                                                Command="{Binding DataContext.AddOptionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"/>

                                        <DataGrid Grid.Row="2"
                                                  ItemsSource="{Binding Options}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  MaxHeight="140">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Meal"
                                                                        Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ComboBox ItemsSource="{Binding DataContext.Meals, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                      DisplayMemberPath="Name"
                                                                      SelectedValuePath="Id"
                                                                      SelectedValue="{Binding MealId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="Extra"
                                                                    Width="80"
                                                                    Binding="{Binding AdditionalPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridCheckBoxColumn Header="Default"
                                                                        Width="70"
                                                                        Binding="{Binding IsDefault, Mode=TwoWay}"/>

                                                <DataGridTemplateColumn Width="80">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Remove"
                                                                    Command="{Binding DataContext.RemoveOptionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Page>