@page "/"

<div class="dashboard-container">
    <aside class="sidebar">
        <div class="profile-section">
            <img src="https://via.placeholder.com/50" class="avatar" />
            <p>Jack Gibbs</p>
        </div>
        <nav class="nav-menu">
            <button class="nav-item active">Home</button>
            <button class="nav-item">Menu</button>
            <button class="nav-item">Articles</button>
            <button class="nav-item">Settings</button>
        </nav>
    </aside>

    <main class="main-content">
        <header class="header">
            <h1>Welcome to <span>Eatland 😋</span></h1>
            <div class="search-bar">
                <input type="text" placeholder="Search..." />
            </div>
        </header>

        <section class="categories">
            <div class="category-card active">All</div>
            <div class="category-card">Burgers</div>
            <div class="category-card">Pizza</div>
            <div class="category-card">Salads</div>
        </section>

        <section class="product-section">
            <h3>All items</h3>
            <div class="product-grid">
                <div class="product-card">
                    <img src="https://via.placeholder.com/100" />
                    <h4>Burger 'Wanted'</h4>
                    <p>$39</p>
                    <button class="add-btn">+</button>
                </div>
            </div>
        </section>
    </main>
</div>